
<% const currentDirection = (typeof direction !== 'undefined' && direction) ? direction : 'MA-FR'; %>

<div class="admin-page">
  <%- include('../partials/admin-navbar', { currentPage: 'clients', direction: currentDirection }) %>

  <!-- Contenu principal -->
  <main class="admin-main">
    <!-- SECTION 1: Gestion des Clients -->
    <div class="clients-section clients-management">
      <div class="section-header">
        <div class="search-section">
          <h2>Gestion des Clients</h2>
          <form method="GET" action="/clients" class="search-form">
            <input type="hidden" name="direction" value="<%= currentDirection %>">
            <input 
              type="search" 
              name="q" 
              placeholder="Rechercher un client par nom, téléphone, email..." 
              value="<%= q || '' %>"
              class="search-input"
            />
          </form>
          <button class="btn-add" id="openAddModal">+ Ajouter</button>
        </div>
      </div>

      <!-- Statistique -->
      <div class="clients-stat">
        <div class="stat-icon">👥</div>
        <div class="stat-content">
          <span class="stat-label">Total Clients</span>
          <span class="stat-value"><%= clients.length %></span>
        </div>
      </div>
    </div>

    <!-- SECTION 2: Liste des Clients -->
    <div class="clients-section clients-list-section">
      <div class="section-header">
        <h2>Liste des Clients</h2>
        <p>Consultez et gérez vos clients enregistrés</p>
      </div>

      <% if (clients.length > 0) { %>
        <div class="clients-table-wrapper">
          <table class="clients-table">
            <thead>
              <tr>
                <th>Nom</th>
                <th>Téléphone</th>
                <th>Ville</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% clients.forEach(c => { %>
                <tr data-id="<%= c._id %>">
                  <td><%= c.name %></td>
                  <td><%= c.phone %></td>
                  <td><%= c.city || '-' %></td>
  
                  <td class="actions">
                    <button class="btn-icon edit-btn" 
                            data-id="<%= c._id %>" 
                            data-name="<%= c.name %>" 
                            data-phone="<%= c.phone %>" 
                            data-city="<%= c.city || '' %>"  
                            title="Modifier">✏️</button>
                    <button class="btn-icon delete-btn" data-id="<%= c._id %>" title="Supprimer">🗑️</button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="clients-empty">
          <div class="empty-icon">👥</div>
          <p class="empty-title">Aucun client trouvé</p>
          <p class="empty-subtitle">Ajoutez votre premier client ou modifiez votre recherche</p>
        </div>
      <% } %>
    </div>
    <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1 && clients.length > 0) { %>
  <div class="pagination-container">
    <div class="pagination-info">
      Affichage <%= (pagination.page - 1) * pagination.limit + 1 %> - 
      <%= Math.min(pagination.page * pagination.limit, pagination.totalItems) %> 
      sur <%= pagination.totalItems %> client(s)
    </div>
    <div class="pagination-links">
      <% if (pagination.prevPage) { %>
        <a href="?page=<%= pagination.prevPage %><%= q ? '&q=' + encodeURIComponent(q) : '' %>&direction=<%= encodeURIComponent(currentDirection) %>" class="page-link-blue">← Précédent</a>
      <% } else { %>
        <span class="page-link-blue disabled">← Précédent</span>
      <% } %>

      <% for (let i = 1; i <= pagination.totalPages; i++) { %>
        <% if (i === pagination.page) { %>
          <span class="page-link-blue active"><%= i %></span>
        <% } else { %>
          <a href="?page=<%= i %><%= q ? '&q=' + encodeURIComponent(q) : '' %>&direction=<%= encodeURIComponent(currentDirection) %>" class="page-link-blue"><%= i %></a>
        <% } %>
      <% } %>

      <% if (pagination.nextPage) { %>
        <a href="?page=<%= pagination.nextPage %><%= q ? '&q=' + encodeURIComponent(q) : '' %>&direction=<%= encodeURIComponent(currentDirection) %>" class="page-link-blue">Suivant →</a>
      <% } else { %>
        <span class="page-link-blue disabled">Suivant →</span>
      <% } %>
    </div>
  </div>
<% } %>
  </main>
</div>

<!-- TOAST NOTIFICATION -->
<div id="toast" class="toast hidden">
  <span class="toast-icon" id="toastIcon">✓</span>
  <span class="toast-message" id="toastMessage"></span>
</div>

<!-- MODAL AJOUT/MODIFICATION CLIENT -->
<div id="clientModal" class="modal">
  <div class="modal-content">
    <button class="modal-close">&times;</button>
    <h2 id="modalTitle">Ajouter un client</h2>
    <form id="clientForm" method="POST">
      <input type="hidden" name="_method" id="methodField" value="POST">
      <input type="hidden" name="id" id="clientId">
      
      <div class="form-group">
        <label>Nom <span class="field-arabic">(الاسم الكامل)</span></label>
        <input type="text" name="name" id="clientName" placeholder="Ex: SARA" required>
      </div>

      <div class="form-group">
        <label>Ville <span class="field-arabic">(المدينة)</span></label>
        <select name="city" id="clientCity" required>
          <option value="">Sélectionner une ville</option>
          <% if (typeof cities !== 'undefined' && cities) { %>
            <% cities.forEach(city => { %>
              <option value="<%= city.name %>"><%= city.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- Sélecteur de téléphone personnalisé -->
      <div class="form-group">
        <label>Téléphone <span class="field-arabic">(رقم الهاتف)</span></label>
        <div class="phone-input-group">
          <div class="country-selector" id="countrySelector">
            <span class="selected-flag" id="selectedFlag">🇲🇦</span>
            <span class="selected-dial" id="selectedDial">+212</span>
            <svg class="dropdown-arrow" viewBox="0 0 24 24" width="16" height="16">
              <path fill="currentColor" d="M7 10l5 5 5-5z"></path>
            </svg>
            <div class="country-dropdown" id="countryDropdown"></div>
          </div>
          <input type="tel" name="phone" id="clientPhone" class="phone-input" placeholder="06..." required>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" id="cancelModal">Annuler</button>
        <button type="submit" class="btn btn-primary" id="submitBtn">Ajouter</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL DE CONFIRMATION SUPPRESSION -->
<div id="deleteModal" class="modal">
  <div class="modal-content modal-small">
    <button class="modal-close">&times;</button>
    <div class="modal-icon">⚠️</div>
    <h2>Confirmer la suppression</h2>
    <p>Êtes-vous sûr de vouloir supprimer ce client ? Cette action est irréversible.</p>
    <div class="modal-actions">
      <button type="button" class="btn btn-secondary" id="cancelDelete">Annuler</button>
      <button type="button" class="btn btn-danger" id="confirmDelete">Supprimer</button>
    </div>
  </div>
</div>

<style>
/* Tous vos styles existants (inchangés) */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  background: #f3f4f6;
}

  /* Hide global top bar navigation on the admin dashboard */
  .topbar { display: none !important; }
/* ===== SIDEBAR ===== */
.admin-page {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 24px;
  min-height: calc(100vh - 80px);
  align-items: stretch;
  padding: 20px;
