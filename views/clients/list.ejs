/* ===== TOAST STYLES ===== */
.toast {
  position: fixed;
  top: 24px;
  right: 24px;
  background: #10b981;
  color: white;
  padding: 14px 20px;
  border-radius: 10px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 600;
  font-size: 14px;
  z-index: 2000;
  animation: slideInRight 0.3s ease-out;
}

.toast.error {
  background: #ef4444;
}

.toast.hidden {
  display: none;
}

.toast-icon {
  font-size: 18px;
  font-weight: bold;
}

.toast-message {
  flex: 1;
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(100px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideOutRight {
  from {
    opacity: 1;
    transform: translateX(0);
  }
  to {
    opacity: 0;
    transform: translateX(100px);
  }
}

.toast.hide {
  animation: slideOutRight 0.3s ease-in;
}

@media (max-width: 640px) {
  .clients-management .section-header .search-section {
    flex-direction: column;
    align-items: stretch;
  }
  .search-section {
    flex-direction: column;
    align-items: stretch;
  }
  .btn-add {
    text-align: center;
  }
  .clients-table {
    font-size: 0.85rem;
  }
  .clients-table th,
  .clients-table td {
    padding: 10px 12px;
  }
}
/* ===== PAGINATION CLIENTS ===== */
.pagination-container {
  margin-top: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.pagination-info {
  font-size: 13px;
  color: #64748b;
}

.pagination-links {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
}

.page-link-blue {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 40px;
  height: 40px;
  padding: 0 12px;
  border-radius: 10px;
  background: #f8fafc;
  color: #334155;
  text-decoration: none;
  border: 1px solid #e2e8f0;
  transition: all 0.2s;
}

.page-link-blue:hover {
  background: #e2e8f0;
}

.page-link-blue.active {
  background: #0b2f62;
  color: white;
  border-color: #0b2f62;
}

.page-link-blue.disabled {
  opacity: 0.5;
  pointer-events: none;
}
</style>

<script>
// ===== TOAST NOTIFICATION =====
function showToast(message, isError = false, duration = 3000) {
  const toast = document.getElementById('toast');
  const toastMessage = document.getElementById('toastMessage');
  const toastIcon = document.getElementById('toastIcon');
  
  toast.classList.remove('error', 'hidden', 'hide');
  toastIcon.textContent = isError ? '✕' : '✓';
  toast.classList.add(isError ? 'error' : 'success');
  toastMessage.textContent = message;
  toast.classList.remove('hidden');
  
  setTimeout(() => {
    toast.classList.add('hide');
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 300);
  }, duration);
}

// ===== GESTION DES MODALS =====
const addModal = document.getElementById('clientModal');
const deleteModal = document.getElementById('deleteModal');
const modalTitle = document.getElementById('modalTitle');
const clientForm = document.getElementById('clientForm');
const methodField = document.getElementById('methodField');
const clientId = document.getElementById('clientId');
const clientName = document.getElementById('clientName');
const clientCity = document.getElementById('clientCity');
const clientPhone = document.getElementById('clientPhone');
const submitBtn = document.getElementById('submitBtn');
const cancelModal = document.getElementById('cancelModal');
const cancelDelete = document.getElementById('cancelDelete');
const confirmDelete = document.getElementById('confirmDelete');
const countrySelector = document.getElementById('countrySelector');
const selectedFlag = document.getElementById('selectedFlag');
const selectedDial = document.getElementById('selectedDial');
const countryDropdown = document.getElementById('countryDropdown');
const directionPhoneConfig = {
  'MA-FR': {
    code: 'MA',
    dial: '+212',
    flag: '🇲🇦',
    name: 'Maroc',
    placeholder: '+212 6XX XXX XXX',
  },
  'FR-MA': {
    code: 'FR',
    dial: '+33',
    flag: '🇫🇷',
    name: 'France',
    placeholder: '+33 6XX XXX XXX',
  },
};
const activeDirection = '<%= currentDirection %>';
let deleteId = null;

function getPhoneConfigByDirection(direction) {
  return directionPhoneConfig[direction] || directionPhoneConfig['MA-FR'];
}

function syncPhoneFieldWithDirection(direction) {
  const config = getPhoneConfigByDirection(direction);

  if (selectedFlag) {
    selectedFlag.textContent = config.flag;
  }

  if (selectedDial) {
    selectedDial.textContent = config.dial;
  }

  if (clientPhone) {
    clientPhone.placeholder = config.placeholder;
    clientPhone.dataset.countryCode = config.dial;
  }

  if (countryDropdown) {
    countryDropdown.innerHTML = '';

    const option = document.createElement('div');
    option.className = 'country-option';
    option.innerHTML = `${config.flag} ${config.name} (${config.dial})`;
    option.dataset.dial = config.dial;
    option.dataset.flag = config.flag;
    countryDropdown.appendChild(option);
  }
}

// Ouvrir modal d'ajout
document.getElementById('openAddModal').addEventListener('click', () => {
  modalTitle.textContent = 'Ajouter un client';
  methodField.value = 'POST';
  clientForm.action = '/clients';
  clientId.value = '';
  clientName.value = '';
  clientCity.value = '';
  clientPhone.value = '';
  syncPhoneFieldWithDirection(activeDirection);
  submitBtn.textContent = 'Ajouter';
  addModal.classList.add('show');
});

// Ouvrir modal de modification
document.querySelectorAll('.edit-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const id = btn.dataset.id;
    const name = btn.dataset.name;
    const phone = btn.dataset.phone;
    const city = btn.dataset.city;
    modalTitle.textContent = 'Modifier le client';
    methodField.value = 'PUT';
    clientForm.action = `/clients/${id}?_method=PUT`;
    clientId.value = id;
    clientName.value = name;
    clientCity.value = city;
    syncPhoneFieldWithDirection(activeDirection);
    clientPhone.value = phone;
    submitBtn.textContent = 'Modifier';
    addModal.classList.add('show');
  });
});

// Fermer les modals
const closeModals = () => {
  addModal.classList.remove('show');
  deleteModal.classList.remove('show');
  countryDropdown?.classList.remove('show');
  countrySelector?.classList.remove('open');
};

document.querySelectorAll('.modal-close').forEach(btn => btn.addEventListener('click', closeModals));
cancelModal.addEventListener('click', closeModals);
cancelDelete.addEventListener('click', closeModals);

// Soumettre le formulaire avec AJAX
clientForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  
  const formData = {
    name: clientName.value,
    phone: clientPhone.value,
    city: clientCity.value,
  };
  
  const emailField = document.querySelector('input[name="email"]');
  if (emailField && emailField.value) {
    formData.email = emailField.value;
  }
  
  try {
    const method = methodField.value;
    const url = clientForm.action.replace('?_method=PUT', '');
    
    const response = await fetch(url, {
      method: method,
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify(formData)
    });
    
    const data = await response.json() || {};
    
    if (!response.ok) {
      if (data.errors && Array.isArray(data.errors)) {
        data.errors.forEach(err => {
          showToast(err.msg || 'Erreur', true, 4000);
        });
      } else if (data.error) {
        showToast(data.error, true, 4000);
      } else {
        showToast('Erreur lors de l\'ajout/modification', true, 4000);
      }
    } else {
      const successMsg = method === 'PUT' 
        ? 'Client modifié avec succès ✓' 
        : 'Client ajouté avec succès ✓';
      showToast(successMsg, false);
      closeModals();
      setTimeout(() => {
        window.location.href = `/clients?direction=${encodeURIComponent(activeDirection)}`;
      }, 1500);
    }
  } catch (err) {
    console.error('Erreur:', err);
    showToast('Erreur lors du traitement: ' + err.message, true, 4000);
  }
});

// Ouvrir modal de suppression
document.querySelectorAll('.delete-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    deleteId = btn.dataset.id;
    deleteModal.classList.add('show');
  });
});

// Confirmer suppression
confirmDelete.addEventListener('click', async () => {
  if (deleteId) {
    try {
      const response = await fetch(`/clients/${deleteId}`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        }
      });
      
      if (response.ok) {
        showToast('✓ Suppression avec succès', false);
        closeModals();
        setTimeout(() => {
          window.location.href = `/clients?direction=${encodeURIComponent(activeDirection)}`;
        }, 1500);
      } else {
        const data = await response.json();
        showToast('Erreur: ' + (data.error || 'Erreur inconnue'), true, 4000);
      }
    } catch (err) {
      showToast('Erreur lors de la suppression: ' + err.message, true, 4000);
    }
  }
});

// Fermer en cliquant sur le fond
window.addEventListener('click', (e) => {
  if (e.target.classList.contains('modal')) {
    e.target.classList.remove('show');
  }
});

// ===== SÉLECTEUR DE PAYS PERSONNALISÉ =====
if (countrySelector && selectedFlag && selectedDial && countryDropdown) {
  syncPhoneFieldWithDirection(activeDirection);

  // Ouvrir/fermer la dropdown au clic sur le sélecteur
  countrySelector.addEventListener('click', (e) => {
    e.stopPropagation();
    countryDropdown.classList.toggle('show');
    countrySelector.classList.toggle('open');
  });

  // Ouvrir/fermer la dropdown au clic sur le champ téléphone
  if (clientPhone) {
    clientPhone.addEventListener('click', (e) => {
      e.stopPropagation();
      countryDropdown.classList.toggle('show');
      countrySelector.classList.toggle('open');
    });
  }

  // Fermer la dropdown si on clique ailleurs (sauf sur le champ téléphone ou le sélecteur)
  document.addEventListener('click', (e) => {
    if (!countrySelector.contains(e.target) && !(clientPhone && clientPhone.contains(e.target))) {
      countryDropdown.classList.remove('show');
      countrySelector.classList.remove('open');
    }
  });
}
</script>
