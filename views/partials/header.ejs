<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= (typeof title !== 'undefined' && title) ? title + ' | CASMOH SARL' : 'CASMOH SARL' %></title>
  <link rel="stylesheet" href="/public/css/style.css"/>
  <link rel="stylesheet" href="/public/css/auth.css"/>
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <div class="logo">
        <div class="logo-main">CASMOH</div>
        <div class="logo-sub">Transport de bagages Non accompagnés</div>
      </div>
    </div>
    <nav class="nav">
      <a class="nav-pill <%= (typeof navActive !== 'undefined' && navActive==='home') ? 'active' : '' %>" href="/">Accueil</a>
      <a class="nav-pill" href="/#services">Services</a>

      <% if (typeof user !== 'undefined' && user) { %>
        <!-- Utilisateur connecté -->
        <% const isAdminUser = user && ((user.type && user.type === 'admin') || (user.role && user.role === 'admin')); %>
        <% const isClientUser = user && ((user.type && user.type === 'client') || (user.role && user.role === 'client')); %>
        <% if (isAdminUser) { %>
          <a class="nav-pill" href="/admin/dashboard">Admin</a>
        <% } else { %>
          <div class="nav-user">
            <% if (isClientUser) { %>
              <a class="user-info user-info-link" href="/client-dashboard" title="Retour à mon espace client">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 5px;">
                  <circle cx="12" cy="8" r="4"/>
                  <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                </svg>
                <span class="user-name"><%= user.name %></span>
              </a>
            <% } else { %>
              <div class="user-info">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 5px;">
                  <circle cx="12" cy="8" r="4"/>
                  <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                </svg>
                <span class="user-name"><%= user.name %></span>
              </div>
            <% } %>
            <form method="POST" action="/auth/logout" style="display: inline;" id="logoutForm">
              <button type="submit" class="logout-icon-btn" title="Se déconnecter">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                  <polyline points="16 17 21 12 16 7"/>
                  <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
              </button>
            </form>
          </div>
        <% } %>
      <% } else { %>
        <!-- Utilisateur non connecté : seulement Connexion -->
        <a class="nav-pill btn-outline" href="/auth/login">Connexion</a>
      <% } %>
    </nav>
  </header>
  <script>
    window.addEventListener('pageshow', function (event) {
      const isBackOrForward = event.persisted || (performance.getEntriesByType && performance.getEntriesByType('navigation').some(entry => entry.type === 'back_forward'));
      if (isBackOrForward) {
        window.location.reload();
      }
    });
  </script>
  <main class="container">
