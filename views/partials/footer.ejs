        <label class="btn btn-outline">
          Restaurer
          <input type="file" name="file" accept="application/json" onchange="this.form.submit()" hidden>
        </label>
      </form>
      <% } %>
    </div>
    <p>&copy; <%= new Date().getFullYear() %> CASMOH SARL</p>
  </footer>
  <script src="/public/js/main.js"></script>
</body>
</html>
