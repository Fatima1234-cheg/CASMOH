<% const currentDirection = (typeof direction !== 'undefined' && direction) ? direction : 'MA-FR'; %>

<!-- Barre latérale fixe (sera incluse dans chaque vue admin) -->
  <aside class="admin-sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-logo">CASMOH</div>
    
    </div>

    <div class="sidebar-section">
      <div class="sidebar-section-title">DIRECTION</div>
      <div class="direction-toggle">
        <a href="?direction=MA-FR" data-direction-nav="MA-FR" class="direction-btn <%= currentDirection === 'MA-FR' ? 'active active-ma-fr' : '' %>"><%= directionDisplay('MA-FR') %></a>
        <a href="?direction=FR-MA" data-direction-nav="FR-MA" class="direction-btn <%= currentDirection === 'FR-MA' ? 'active active-fr-ma' : '' %>"><%= directionDisplay('FR-MA') %></a>
      </div>
    </div>

  <nav class="sidebar-nav">
  <a href="/admin/dashboard" class="sidebar-link <%= currentPage === 'dashboard' ? 'active' : '' %>">Tableau de bord</a>
  <a href="/orders/new<%= currentDirection ? ('?direction=' + currentDirection) : '' %>" class="sidebar-link <%= currentPage === 'new-order' ? 'active' : '' %>">Ajouter un colis</a>
  <a href="/orders<%= currentDirection ? ('?direction=' + currentDirection) : '' %>" class="sidebar-link <%= currentPage === 'orders' ? 'active' : '' %>">Liste des colis</a>
  <a href="/clients<%= currentDirection ? ('?direction=' + currentDirection) : '' %>" class="sidebar-link <%= currentPage === 'clients' ? 'active' : '' %>">Clients</a>
  <a href="/cities" class="sidebar-link <%= currentPage === 'cities' ? 'active' : '' %>">Villes</a>
 <a href="/transporteurs" class="sidebar-link <%= currentPage === 'transporteurs' ? 'active' : '' %>">Transporteurs</a>
  
  <button type="button" class="sidebar-link sidebar-action-btn" id="openResetModal">
    <span>Se réinitialiser</span>
  </button>
  <a href="/demandes" class="sidebar-link <%= currentPage === 'demandes' ? 'active' : '' %>">Demandes</a>
  
  <form method="POST" action="/auth/logout" style="margin: 0;">
    <button type="submit" class="sidebar-link logout-btn">
      <span>Se déconnecter</span>
    </button>
  </form>
</nav>
  </aside>
  <div class="reset-modal-backdrop" id="resetModal" aria-hidden="true">
    <div class="reset-modal-card" role="dialog" aria-modal="true" aria-labelledby="resetTitle">
      <h3 id="resetTitle">Confirmation de sécurité</h3>
      <p>Saisissez le code de confirmation pour continuer.</p>
      <form method="POST" action="/auth/reset-orders" id="resetForm">
        <div class="reset-password-field">
          <input
            type="password"
            id="resetSecurityCode"
            class="reset-modal-input"
            placeholder="Code de confirmation"
            autocomplete="off"
          >
          <button type="button" class="reset-password-toggle" id="toggleResetSecurityCode" aria-label="Afficher ou masquer le code">
            <span class="eye-open" aria-hidden="true">👁</span>
            <span class="eye-closed hidden" aria-hidden="true">🙈</span>
          </button>
        </div>
        <div id="resetModalError" class="reset-modal-error hidden">Mot de passe incorrect</div>
        <div id="resetModalSuccess" class="reset-modal-success hidden">Vos commandes sont supprimées</div>
        <div class="reset-modal-actions">
          <button type="button" class="reset-modal-cancel" id="cancelReset">Annuler</button>
          <button type="submit" class="reset-modal-confirm">Supprimer</button>
        </div>
      </form>
    </div>
  </div>
  <style>
    
  .admin-page {
    display: block !important;
    padding-left: 0 !important;
    min-height: 100vh !important;
    background: #f0f2f5 !important;
  }

  .admin-sidebar {
    background: linear-gradient(180deg, #0b2f62 0%, #0a263f 100%);
    color: #fff;
    padding: 24px 18px;
    border-radius: 15px;
    position: fixed !important;
    top: 20px !important;
    left: 20px !important;
    bottom: 20px !important;
    width: 300px !important;
    height: calc(100vh - 40px) !important;
    overflow-y: auto !important;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .admin-main {
    margin-left: 340px !important;
    padding: 28px 28px 40px 28px !important;
    min-height: calc(100vh -20px) !important;
    width: auto !important;
    background: transparent !important;
    overflow-y: auto !important;
  }

  .sidebar-logo {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 20px;
    letter-spacing: 0.5px;
  }

  .sidebar-subtitle {
    margin-top: 4px;
    font-size: 12px;
    opacity: 0.7;
    
  }

  .sidebar-section-title {
    font-size: 12px;
    letter-spacing: 1px;
    margin-bottom: 10px;
    opacity: 0.8;
  }

  .direction-toggle {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 32px;
  }

  .direction-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-weight: 600;
  
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .direction-btn.active {
    border-width: 2px;
    color: #fff;
    animation: directionHeartbeat 1.1s ease-in-out infinite;
  }

  .direction-btn.active-ma-fr {
    background: linear-gradient(135deg, rgba(96, 165, 250, 0.92), rgba(37, 99, 235, 0.92));
    border-color: rgba(191, 219, 254, 0.95);
    box-shadow: 0 14px 30px rgba(37, 99, 235, 0.32);
  }

  .direction-btn.active-fr-ma {
    background: linear-gradient(135deg, rgba(52, 211, 153, 0.92), rgba(5, 150, 105, 0.92));
    border-color: rgba(167, 243, 208, 0.95);
    box-shadow: 0 14px 30px rgba(5, 150, 105, 0.32);
  }

  .direction-btn.is-clicked {
    animation: directionHeartbeat 0.7s ease-in-out 2;
  }

  @keyframes directionHeartbeat {
    0% { transform: scale(1); }
    14% { transform: scale(1.07); }
    28% { transform: scale(1); }
    42% { transform: scale(1.09); }
    70% { transform: scale(1); }
    100% { transform: scale(1); }
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  
  }

  .sidebar-link {
    padding: 12px 14px;
    border-radius: 14px;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    transition: background 0.2s, color 0.2s;
  }

  .sidebar-link:hover,
  .sidebar-link.active {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }
  .sidebar-link.sidebar-action-btn,
  .sidebar-link.logout-btn {
  width: 100%;       /* Prend toute la largeur de la sidebar */
  background: none;  /* Supprime le fond par défaut du bouton */
  border: none;      /* Supprime la bordure */
  cursor: pointer;   /* Ajoute le curseur main */
  text-align: left;  /* Aligne le texte à gauche comme les liens */
  font-family: inherit; /* Utilise la même police que le reste */
  font-size: inherit;   /* Utilise la même taille que le reste */
  display: flex;     /* Pour l'alignement des icônes si tu en ajoutes */
  align-items: center;
  font-size: 20px;
}

/* Optionnel : Si tu veux un effet spécifique au survol pour la déconnexion (ex: rouge léger) */
.sidebar-link.logout-btn:hover {
  background: rgba(239, 68, 68, 0.2); /* Un fond rouge transparent très léger */
  color: #ff4d4d; /* Texte un peu plus clair */
}

.reset-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.6);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px;
  z-index: 9999;
}

.reset-modal-backdrop.show {
  display: flex;
}

.reset-modal-card {
  width: min(100%, 520px);
  background: #fff;
  color: #0f172a;
  border-radius: 24px;
  padding: 28px;
  box-shadow: 0 24px 60px rgba(15, 23, 42, 0.28);
}

.reset-modal-card h3 {
  margin: 0 0 12px;
  font-size: 24px;
}

.reset-modal-card p {
  margin: 0 0 12px;
  line-height: 1.6;
  color: #334155;
}

.reset-password-field {
  position: relative;
}

.reset-modal-input {
  width: 100%;
  border: 1px solid #cbd5e1;
  border-radius: 14px;
  padding: 12px 48px 12px 14px;
  font-size: 15px;
  outline: none;
}

.reset-modal-input:focus {
  border-color: #0b2f62;
  box-shadow: 0 0 0 3px rgba(11, 47, 98, 0.1);
}

.reset-password-toggle {
  position: absolute;
  top: 50%;
  right: 12px;
  transform: translateY(-50%);
  width: 30px;
  height: 30px;
  border: none;
  background: transparent;
  color: #0b2f62;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 18px;
  opacity: 1;
}

.reset-password-toggle:hover {
  background: rgba(11, 47, 98, 0.12);
}

.reset-modal-error {
  margin-top: 10px;
  color: #dc2626;
  font-weight: 700;
}

.reset-modal-success {
  margin-top: 10px;
  color: #166534;
  font-weight: 700;
}

.reset-modal-error.hidden,
.reset-modal-success.hidden,
.eye-open.hidden,
.eye-closed.hidden {
  display: none;
}

.reset-modal-actions {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
  margin-top: 24px;
}

.reset-modal-cancel,
.reset-modal-confirm {
  border: none;
  border-radius: 999px;
  padding: 12px 18px;
  font-weight: 700;
  cursor: pointer;
}

.reset-modal-cancel {
  background: #e2e8f0;
  color: #0f172a;
}

.reset-modal-confirm {
  background: #dc2626;
  color: #fff;
}
  </style>
  <script>
    (function () {
      const modal = document.getElementById('resetModal');
      const openBtn = document.getElementById('openResetModal');
      const cancelBtn = document.getElementById('cancelReset');
      const form = document.getElementById('resetForm');
      const codeInput = document.getElementById('resetSecurityCode');
      const errorBox = document.getElementById('resetModalError');
      const successBox = document.getElementById('resetModalSuccess');
      const toggleCodeBtn = document.getElementById('toggleResetSecurityCode');
      const directionButtons = document.querySelectorAll('[data-direction-nav]');

      if (!modal || !openBtn || !cancelBtn || !form || !codeInput || !errorBox || !successBox) return;

      async function readResetResponse(response) {
        const contentType = response.headers.get('content-type') || '';
        if (contentType.includes('application/json')) {
          return response.json();
        }
        const rawText = await response.text();
        return {
          success: false,
          error: /^\s*</.test(rawText) ? 'Page non trouvee ou route indisponible' : (rawText || 'Erreur serveur')
        };
      }

      function closeModal() {
        modal.classList.remove('show');
        modal.setAttribute('aria-hidden', 'true');
      }

      function openModal() {
        modal.classList.add('show');
        modal.setAttribute('aria-hidden', 'false');
        codeInput.value = '';
        codeInput.type = 'password';
        errorBox.classList.add('hidden');
        successBox.classList.add('hidden');
        if (toggleCodeBtn) {
          toggleCodeBtn.querySelector('.eye-open')?.classList.remove('hidden');
          toggleCodeBtn.querySelector('.eye-closed')?.classList.add('hidden');
        }
        window.setTimeout(function () {
          codeInput.focus();
        }, 50);
      }

      openBtn.addEventListener('click', openModal);
      cancelBtn.addEventListener('click', closeModal);
      codeInput.addEventListener('input', function () {
        errorBox.classList.add('hidden');
        successBox.classList.add('hidden');
      });
      toggleCodeBtn?.addEventListener('click', function () {
        const showCode = codeInput.type === 'password';
        codeInput.type = showCode ? 'text' : 'password';
        toggleCodeBtn.querySelector('.eye-open')?.classList.toggle('hidden', !showCode);
        toggleCodeBtn.querySelector('.eye-closed')?.classList.toggle('hidden', showCode);
      });
      modal.addEventListener('click', function (event) {
        if (event.target === modal) closeModal();
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeModal();
      });
      form.addEventListener('submit', async function (event) {
        event.preventDefault(); // Prevent native form submission to avoid any 404 routing issues
        
        const confirmBtn = document.querySelector('.reset-modal-confirm');
        const originalText = confirmBtn.textContent;
        const code = String(codeInput.value || '').trim();

        errorBox.classList.add('hidden');
        successBox.classList.add('hidden');
        if (!code) {
          errorBox.textContent = 'Veuillez saisir le code';
          errorBox.classList.remove('hidden');
          return;
        }

        confirmBtn.textContent = 'Suppression en cours...';
        confirmBtn.disabled = true;

        try {
          const response = await fetch('/auth/reset-orders', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ code })
          });

          const payload = await readResetResponse(response);
          if (response.ok && payload.success) {
            successBox.textContent = payload.message || 'Vos commandes sont supprimées';
            successBox.classList.remove('hidden');
            window.setTimeout(function () {
              window.location.reload();
            }, 900);
          } else {
            errorBox.textContent = payload.error || 'Mot de passe incorrect';
            errorBox.classList.remove('hidden');
          }
        } catch (error) {
          console.error('Erreur:', error);
          errorBox.textContent = 'Erreur de connexion. Veuillez verifier votre reseau.';
          errorBox.classList.remove('hidden');
        } finally {
          confirmBtn.textContent = originalText;
          confirmBtn.disabled = false;
        }
      });

      directionButtons.forEach(function (button) {
        const direction = button.getAttribute('data-direction-nav');
        button.addEventListener('click', function (event) {
          event.preventDefault();
          directionButtons.forEach(function (item) {
            item.classList.remove('active', 'active-ma-fr', 'active-fr-ma', 'is-clicked');
          });
          button.classList.add('active', 'is-clicked', direction === 'MA-FR' ? 'active-ma-fr' : 'active-fr-ma');
          window.setTimeout(function () {
            window.location.href = button.href;
          }, 320);
        });
      });
    })();
  </script>
