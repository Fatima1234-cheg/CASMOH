                </div>
                <span class="camera-label">Ajouter</span>
                <span class="file-hint">PNG, JPG, GIF jusqu'à 10 Mo</span>
                <input type="file" name="photos" multiple accept="image/png, image/jpeg, image/gif" hidden id="photoInput" required>
              </label>
            </div>
            <div id="photoPreview" class="photo-list"></div>
          </div>
        </div>
      </div>
