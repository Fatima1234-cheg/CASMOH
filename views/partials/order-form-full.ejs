          </div>

          <div class="field-group">
            <label>Description du contenu <span class="label-ar">(وصف المحتوى)</span></label>
            <textarea name="description" placeholder="Ex: vêtements, documents, électronique..." rows="3" required></textarea>
          </div>

          <div class="field-group">
            <label>Poids (Kg) <span class="label-ar">(الوزن)</span></label>
            <input type="text" inputmode="decimal" name="weightKg" placeholder="Ex: 5">
          </div>

          <div class="field-group">
            <label>Nombre de colis <span class="label-ar">(عدد الطرود)</span></label>
            <input type="text" inputmode="numeric" name="parcelsCount">
          </div>

          <div class="field-group">
            <label>Photos des colis</label>
