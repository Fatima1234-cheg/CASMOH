<style>
/* CSS global du formulaire (identique à l'admin) */
.parcel-form-reusable { max-width: 820px; margin: 0 auto; padding: 2rem 1rem; font-family: 'Inter', sans-serif; }
.stepper { display: flex; justify-content: space-between; position: relative; margin-bottom: 3rem; max-width: 600px; margin-left: auto; margin-right: auto; }
.stepper-line { position: absolute; top: 20px; left: 0; right: 0; height: 2px; background: #e2e8f0; z-index: 1; }
.step { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 8px; flex: 1; }
.step-circle { width: 40px; height: 40px; border-radius: 50%; background: white; border: 2px solid #e2e8f0; display: flex; align-items: center; justify-content: center; font-weight: 700; color: #64748b; transition: all 0.3s; }
.step.active .step-circle { border-color: #3b82f6; background: #3b82f6; color: white; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2); }
.step.completed .step-circle { border-color: #10b981; background: #10b981; color: white; }
.step-label { font-size: 0.75rem; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }

.step-content { display: none; animation: fadeIn 0.3s ease; }
.step-content.active { display: block; }

.card { background: white; border-radius: 16px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); position: relative; overflow: visible; margin-bottom: 2rem; }
.card-accent { height: 4px; width: 100%; }
.card-accent.blue { background: #3b82f6; }
.card-accent.green { background: #10b981; }
.card-accent.red { background: #ef4444; }
.card-body { padding: 2rem; }
.card-title { font-size: 1.5rem; font-weight: 800; color: #1e293b; margin-bottom: 0.5rem; }
.card-subtitle { color: #64748b; font-size: 0.9rem; margin-bottom: 2rem; }

.field-group { margin-bottom: 1.5rem; }
.field-group label { display: block; font-weight: 600; font-size: 0.9rem; color: #334155; margin-bottom: 0.5rem; }
.label-ar { color: #94a3b8; font-size: 0.8rem; margin-left: 4px; }

input[type="text"], input[type="number"], input[type="tel"], select, textarea { 
  width: 100%; padding: 0.75rem 1rem; border: 1.5px solid #e2e8f0; border-radius: 10px; font-size: 1rem; transition: all 0.2s; 
}
input:focus, select:focus, textarea:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }

.phone-input { display: grid; grid-template-columns: auto 1fr auto; border: 1.5px solid #e2e8f0; border-radius: 10px; overflow: visible; background: white; }
.cc-toggle { display: flex; align-items: center; gap: 8px; padding: 0 12px; border-right: 1px solid #e2e8f0; cursor: pointer; min-width: 90px; background: #f8fafc; border-radius: 10px 0 0 10px; }
.cc-toggle:hover { background: #f1f5f9; }
.phone-field { border: none !important; border-radius: 0 !important; box-shadow: none !important; }
.whatsapp-btn { background: #25d366; border: none; padding: 0 15px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s; border-radius: 0 10px 10px 0; }
.whatsapp-btn:hover { background: #128c7e; }

.cc-picker { position: relative; z-index: 2000; height: 100%; }
[data-menu] { position: absolute; bottom: 100%; top: auto; left: 0; background: white; border: 1px solid #e2e8f0; border-radius: 12px; z-index: 2000; width: 320px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); max-height: 300px; overflow-y: auto; margin-bottom: 8px; }
[data-menu] button { width: 100%; padding: 12px 16px; border: none; background: none; text-align: left; cursor: pointer; display: flex; align-items: center; gap: 12px; font-size: 14px; color: #1e293b; transition: background 0.2s; }
[data-menu] button:hover { background: #f8fafc; }
.menu-divider { height: 1px; background: #f1f5f9; margin: 4px 0; }
.flag-icon { width: 24px; height: 18px; border-radius: 2px; box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
.arrow { font-size: 10px; color: #94a3b8; }

.nav-buttons { display: flex; gap: 1rem; margin-top: 2rem; }
.btn { flex: 1; padding: 1rem; border-radius: 12px; font-weight: 700; font-size: 1rem; cursor: pointer; transition: all 0.2s; border: none; display: flex; align-items: center; justify-content: center; gap: 8px; }
.btn-next { background: #3b82f6; color: white; flex: 1; }
.btn-next:hover { background: #2563eb; transform: translateY(-1px); }
.btn-back { background: #f1f5f9; color: #64748b; }
.btn-back:hover { background: #e2e8f0; }
.btn-submit { background: #10b981; color: white; flex: 1; padding: 1rem; border-radius: 12px; font-weight: 700; border: none; cursor: pointer; font-size: 1rem; }
.btn-submit:hover { background: #059669; }

.radio-group { display: flex; gap: 1.5rem; margin-top: 0.5rem; }
.radio-option { display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 500; color: #475569; }
.radio-option input { width: 18px; height: 18px; cursor: pointer; }

.file-upload-zone { border: 2px dashed #e2e8f0; border-radius: 16px; padding: 2rem; text-align: center; cursor: pointer; transition: all 0.2s; background: #f8fafc; }
.file-upload-zone:hover { border-color: #3b82f6; background: #eff6ff; }
.upload-icon { position: relative; display: inline-block; margin-bottom: 1rem; }
.upload-plus { position: absolute; right: -5px; bottom: -5px; background: #3b82f6; color: white; width: 20px; height: 20px; border-radius: 50%; font-size: 14px; font-weight: bold; line-height: 20px; }
.camera-label { display: block; font-weight: 700; color: #1e293b; font-size: 1.1rem; }
.file-hint { display: block; color: #94a3b8; font-size: 0.8rem; margin-top: 4px; }
.photo-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
.photo-item { position: relative; border-radius: 12px; overflow: hidden; aspect-ratio: 1; border: 1px solid #e2e8f0; }
.photo-item img { width: 100%; height: 100%; object-fit: cover; }
.photo-remove { position: absolute; top: 4px; right: 4px; background: rgba(0,0,0,0.5); color: white; border: none; border-radius: 50%; width: 24px; height: 24px; cursor: pointer; font-size: 14px; }

@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
@media (max-width: 600px) { .phone-input { grid-template-columns: auto 1fr; } .whatsapp-btn { grid-column: span 2; border-radius: 0 0 10px 10px; border-top: 1px solid #e2e8f0; height: 50px; } }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Navigation
  window.goToFormStep = function(s) {
    const currentStepEl = document.querySelector('.step-content.active');
    const currentStepNum = parseInt(currentStepEl.dataset.step);
    
    if (s > currentStepNum) {
      const inputs = currentStepEl.querySelectorAll('input[required], select[required], textarea[required]');
      let allValid = true;
      for (let input of inputs) {
        if (!input.checkValidity()) {
          input.reportValidity();
          allValid = false;
          break;
        }
      }
      if (!allValid) return;
    }

    document.querySelectorAll('.step-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.step').forEach(el => el.classList.remove('active'));
    document.querySelector(`.step-content[data-step="${s}"]`).classList.add('active');
    document.querySelector(`.step[data-step="${s}"]`).classList.add('active');
    
    document.querySelectorAll('.step').forEach(el => {
      const stepNum = parseInt(el.dataset.step);
      if (stepNum < s) el.classList.add('completed');
      else el.classList.remove('completed');
    });

    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // Stepper Clicks
  document.querySelectorAll('.step').forEach(stepEl => {
    stepEl.style.cursor = 'pointer';
    stepEl.onclick = () => {
      const targetStep = parseInt(stepEl.dataset.step);
      goToFormStep(targetStep);
    };
  });

  // Phone Selectors
  const pickers = document.querySelectorAll('[data-flagpicker]');
  pickers.forEach(picker => {
    const toggle = picker.querySelector('[data-toggle]');
    const menu = picker.querySelector('[data-menu]');
    const dialHidden = picker.querySelector('input[data-dial]');
    const dialText = picker.querySelector('[data-dial-text]');
    const block = picker.closest('[data-phone-block]');
    const localInput = block.querySelector('input[data-local]');
    const fullHidden = block.querySelector('input[data-full]');
    const waBtn = block.querySelector('[data-wa]');

    toggle.onclick = (e) => {
      e.stopPropagation();
      document.querySelectorAll('[data-menu]').forEach(m => { if(m !== menu) m.hidden = true; });
      menu.hidden = !menu.hidden;
    };

    menu.querySelectorAll('button').forEach(btn => {
      btn.onclick = () => {
        const dial = btn.dataset.dial;
        const code = btn.dataset.code;
        dialHidden.value = dial;
        dialText.textContent = dial;
        updateFlagImage(picker, dial);
        menu.hidden = true;
        updateFullValue();
      };
    });

    function updateFullValue() {
      const dial = dialHidden.value.replace(/\s/g, '');
      const local = localInput.value.replace(/\D/g, '');
      fullHidden.value = (dial && local) ? dial + local : '';
    }

    localInput.oninput = updateFullValue;

    // WhatsApp
    waBtn.onclick = () => {
      updateFullValue();
      if (!fullHidden.value) {
        localInput.reportValidity();
        return;
      }
      const dial = dialHidden.value;
      const local = localInput.value;
      const stepNum = block.dataset.step;
      const phone = normalizePhoneForWhatsApp(dial, local);
      const text = encodeURIComponent(buildWhatsAppMessage(stepNum));
      window.open(`https://api.whatsapp.com/send?phone=${phone}&text=${text}`, '_blank');
    };

    updateFlagImage(picker, dialHidden.value);
  });

  document.onclick = () => document.querySelectorAll('[data-menu]').forEach(m => m.hidden = true);

  function updateFlagImage(picker, dial) {
    const flagImg = picker.querySelector('[data-flagimg]');
    const btn = picker.querySelector(`button[data-dial="${dial}"]`);
    const code = btn ? btn.dataset.code : (dial === '+212' ? 'ma' : 'fr');
    if (flagImg) flagImg.className = `flag-icon flag-icon-${code}`;
  }

  function normalizePhoneForWhatsApp(dial, localValue) {
    const dialDigits = String(dial || '').replace(/\D/g, '');
    let localDigits = String(localValue || '').replace(/\D/g, '');
    localDigits = localDigits.replace(/^0+/, '');
    return `${dialDigits}${localDigits}`;
  }

  function buildWhatsAppMessage(step) {
    const senderName = (document.querySelector('[name="senderName"]')?.value || '').trim();
    const senderCity = (document.querySelector('[name="senderCity"]')?.value || '').trim();
    const receiverName = (document.querySelector('[name="receiverName"]')?.value || '').trim();
    const parcelsCount = (document.querySelector('[name="parcelsCount"]')?.value || '1').trim();
    // Les clients n'ont pas encore de numéro de commande à l'affichage avant création, on peut mettre "Nouveau"
    const reference = `Nouveau/${parcelsCount}`;

    if (step === '1') {
      return [
        `Bonjour ${senderName || 'Client'},`,
        'Nous vous remercions pour la confiance que vous nous accordez.',
        `Votre colis a ete enregistre avec succes sous la reference ${reference}.`,
        'Nous prenons en charge votre envoi avec attention et professionnalisme.',
        'Notre equipe reste a votre disposition pour toute information complementaire.',
        'Cordialement,',
        'Service Logistique-Cashmoh',
      ].join('\n');
    }

    return [
      `Bonjour ${receiverName || 'Destinataire'},`,
      `Nous vous informons qu'un colis vous sera livre de la part de ${senderName || 'Expediteur'}, depuis ${senderCity || 'ville non renseignee'}.`,
      `Reference colis : ${reference}`,
      'Merci de votre confiance.',
      'Cordialement,',
      'Service Logistique-Cashmoh',
    ].join('\n');
  }

  // Photo Preview with delete functionality
  const photoInput = document.getElementById('photoInput');
  const photoPreview = document.getElementById('photoPreview');
  let selectedFiles = [];
  
  if (photoInput) {
    function renderPhotos() {
      photoPreview.innerHTML = '';
      selectedFiles.forEach((file, index) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const div = document.createElement('div');
          div.className = 'photo-item';
          div.style.position = 'relative';
          div.style.display = 'inline-block';
          
          const img = document.createElement('img');
          img.src = e.target.result;
          div.appendChild(img);
          
          const removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'photo-remove';
          removeBtn.innerHTML = '×';
          removeBtn.onclick = (event) => {
            event.preventDefault();
            selectedFiles.splice(index, 1);
            updateFileInput();
            renderPhotos();
          };
          div.appendChild(removeBtn);
          
          photoPreview.appendChild(div);
        };
        reader.readAsDataURL(file);
      });
    }
    
    function updateFileInput() {
      const dt = new DataTransfer();
      selectedFiles.forEach(f => dt.items.add(f));
      photoInput.files = dt.files;
    }
    
    photoInput.onchange = () => {
      selectedFiles = Array.from(photoInput.files);
      renderPhotos();
    };
  }
});
</script>
