            <label>Pays d'origine</label>
            <div class="custom-select" data-target="editOrigine">
              <div class="custom-select-trigger">
                <span class="flag-icon flag-icon-ma"></span> <span>Maroc</span>
              </div>
              <div class="custom-options">
                <div class="custom-option" data-value="MA"><span class="flag-icon flag-icon-ma"></span> Maroc</div>
                <div class="custom-option" data-value="FR"><span class="flag-icon flag-icon-fr"></span> France</div>
                <div class="custom-option" data-value="ES"><span class="flag-icon flag-icon-es"></span> Espagne</div>
                <div class="custom-option" data-value="IT"><span class="flag-icon flag-icon-it"></span> Italie</div>
                <div class="custom-option" data-value="DE"><span class="flag-icon flag-icon-de"></span> Allemagne</div>
                <div class="custom-option" data-value="BE"><span class="flag-icon flag-icon-be"></span> Belgique</div>
                <div class="custom-option" data-value="CH"><span class="flag-icon flag-icon-ch"></span> Suisse</div>
                <div class="custom-option" data-value="NL"><span class="flag-icon flag-icon-nl"></span> Pays-Bas</div>
                <div class="custom-option" data-value="GB"><span class="flag-icon flag-icon-gb"></span> Royaume-Uni</div>
              </div>
            </div>
            <input type="hidden" id="editOrigine">
          </div>
          <div class="form-group custom-select-group">
            <label>Pays de destination</label>
            <div class="custom-select" data-target="editDestination">
              <div class="custom-select-trigger">
                <span class="flag-icon flag-icon-fr"></span> <span>France</span>
              </div>
              <div class="custom-options">
                <div class="custom-option" data-value="MA"><span class="flag-icon flag-icon-ma"></span> Maroc</div>
                <div class="custom-option" data-value="FR"><span class="flag-icon flag-icon-fr"></span> France</div>
                <div class="custom-option" data-value="ES"><span class="flag-icon flag-icon-es"></span> Espagne</div>
                <div class="custom-option" data-value="IT"><span class="flag-icon flag-icon-it"></span> Italie</div>
                <div class="custom-option" data-value="DE"><span class="flag-icon flag-icon-de"></span> Allemagne</div>
                <div class="custom-option" data-value="BE"><span class="flag-icon flag-icon-be"></span> Belgique</div>
                <div class="custom-option" data-value="CH"><span class="flag-icon flag-icon-ch"></span> Suisse</div>
                <div class="custom-option" data-value="NL"><span class="flag-icon flag-icon-nl"></span> Pays-Bas</div>
                <div class="custom-option" data-value="GB"><span class="flag-icon flag-icon-gb"></span> Royaume-Uni</div>
              </div>
            </div>
            <input type="hidden" id="editDestination">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-cancel close-modal">Annuler</button>
          <button type="submit" class="btn-save">Mettre à jour</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Suppression -->
<div id="deleteModal" class="modal">
  <div class="modal-content modal-small">
    <div class="modal-header">
      <h2>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        Confirmer la suppression
      </h2>
      <button class="modal-close close-modal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <p>Êtes-vous sûr de vouloir supprimer le transporteur :</p>
      <p class="delete-name" id="deleteNom"></p>
      <p class="warning-text">Cette action est irréversible !</p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn-cancel close-modal">Annuler</button>
      <button id="confirmDelete" class="btn-danger">Supprimer</button>
    </div>
  </div>
</div>

<div id="toast" class="toast hidden">✓ Message</div>

<style>
/* ===== STYLES GLOBAUX ===== */
* { margin: 0; padding: 0; box-sizing: border-box; }

.admin-page {
  display: flex;
  min-height: 100vh;
  font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: #0f172a;
}

.admin-main {
  margin-left: 280px;
  flex: 1;
  padding: 24px 32px;
  background: #f2f7ff;
  min-height: 100vh;
  width: calc(100% - 280px);
}
.content-wrapper { flex: 1; overflow-y: auto; padding: 28px; }

.header-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px; }
.header-title h1 { font-size: 26px; font-weight: 700; color: #0f172a; margin-bottom: 6px; }
.header-subtitle { font-size: 14px; color: #64748b; }
.btn-add { background: linear-gradient(135deg, #1e3a5f, #0b2f62); color: white; padding: 12px 24px; border-radius: 12px; border: none; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 8px; transition: all 0.3s; box-shadow: 0 4px 12px rgba(11,47,98,0.2); }
.btn-add:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(11,47,98,0.3); }

.stats-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 28px; }
.stat-card { background: linear-gradient(135deg, #f8fafc, #ffffff); border-radius: 16px; padding: 20px; display: flex; align-items: center; gap: 16px; border: 1px solid #e5e7eb; transition: all 0.3s; }
.stat-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.08); border-color: #cbd5e1; }
.stat-icon { width: 50px; height: 50px; background: linear-gradient(135deg, #e0e7ff, #c7d2fe); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 24px; }
.stat-icon .flag-icon { font-size: 28px; width: auto; height: auto; }
.stat-info { display: flex; flex-direction: column; }
.stat-number { font-size: 28px; font-weight: 800; color: #0f172a; }
.stat-label { font-size: 13px; color: #64748b; }

.table-container { background: #ffffff; border-radius: 20px; border: 1px solid #e5e7eb; overflow: hidden; }
.table-header { padding: 16px 20px; background: #f8fafc; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center; }
.table-title { font-weight: 700; color: #1e293b; font-size: 16px; }
.table-count { background: #e2e8f0; padding: 4px 12px; border-radius: 30px; font-size: 12px; color: #475569; }
.data-table { width: 100%; border-collapse: collapse; }
.data-table th, .data-table td { padding: 14px 16px; text-align: left; border-bottom: 1px solid #f1f5f9; }
.data-table th { background: #fafcff; font-weight: 700; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; }
.data-table tr:hover { background: #f8fafc; }
.cell-nom { font-weight: 700; color: #0f172a; }
.cell-tel { font-family: monospace; color: #334155; }

/* Badges avec drapeaux */
.country-badge { display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px; border-radius: 30px; font-size: 12px; font-weight: 600; }
.country-badge .flag-icon { width: 20px; height: 20px; border-radius: 2px; }
.badge-ma { background: #dcfce7; color: #166534; }
.badge-fr { background: #dbeafe; color: #1e40af; }
.badge-other { background: #fef3c7; color: #92400e; }

.actions { display: flex; gap: 10px; }
.btn-edit, .btn-delete { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 10px; border: none; cursor: pointer; font-size: 13px; font-weight: 600; transition: all 0.2s; }
.btn-edit { background: #eff6ff; color: #1e40af; }
.btn-edit:hover { background: #dbeafe; transform: translateY(-1px); }
.btn-delete { background: #fef2f2; color: #dc2626; }
.btn-delete:hover { background: #fee2e2; transform: translateY(-1px); }

/* Modal */
.modal { display: none; position: fixed; z-index: 2000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); align-items: center; justify-content: center; }
.modal.show { display: flex; }
.modal-content { background: white; border-radius: 24px; width: 90%; max-width: 520px; position: relative; animation: modalSlide 0.3s ease; box-shadow: 0 30px 60px rgba(0,0,0,0.2); overflow: visible; }
.modal-content.modal-small { max-width: 440px; }
@keyframes modalSlide { from { opacity: 0; transform: translateY(-30px); } to { opacity: 1; transform: translateY(0); } }

.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid #e5e7eb; background: #fafcff; }
.modal-header h2 { display: flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 700; color: #0f172a; margin: 0; }
.modal-close { background: #f1f5f9; border: none; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; color: #64748b; }
.modal-close:hover { background: #fee2e2; color: #dc2626; transform: rotate(90deg); }

.modal-body-form { padding: 24px; }
.modal-body { padding: 24px; text-align: center; }

.form-group { margin-bottom: 20px; }
.form-group label { display: block; font-weight: 600; font-size: 14px; color: #1e293b; margin-bottom: 8px; }

/* Custom Select – ouverture vers HAUT et scroll */
.custom-select-group { position: relative; }
.custom-select { position: relative; width: 100%; }
.custom-select-trigger { display: flex; align-items: center; gap: 8px; padding: 12px 14px; border: 1.5px solid #e2e8f0; border-radius: 12px; background: white; cursor: pointer; transition: all 0.2s; }
.custom-select-trigger:hover { border-color: #0b2f62; }
.custom-select-trigger .flag-icon { width: 24px; height: 18px; }
.custom-options {
  display: none;
  position: absolute;
  bottom: 100%;               /* ouvre vers le haut */
  left: 0;
  right: 0;
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  max-height: 200px;
  overflow-y: auto;
  z-index: 1001;
  margin-bottom: 4px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.1);
}
.custom-option { display: flex; align-items: center; gap: 8px; padding: 10px 14px; cursor: pointer; transition: background 0.2s; }
.custom-option:hover { background: #f1f5f9; }
.custom-option .flag-icon { width: 24px; height: 18px; }
.custom-select.open .custom-options { display: block; }

.form-group input[type="text"], .form-group input[type="tel"] { width: 100%; padding: 12px 14px; border: 1.5px solid #e2e8f0; border-radius: 12px; font-size: 14px; transition: all 0.2s; font-family: inherit; background: #fff; }
.form-group input:focus { outline: none; border-color: #0b2f62; box-shadow: 0 0 0 3px rgba(11,47,98,0.1); }

.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 0; }

.modal-footer { display: flex; justify-content: flex-end; gap: 12px; padding: 20px 24px; border-top: 1px solid #e5e7eb; background: #fafcff; }

.delete-name { font-size: 18px; font-weight: 700; color: #dc2626; margin: 12px 0; }
.warning-text { font-size: 13px; color: #dc2626; margin-top: 12px; }

.btn-save { background: linear-gradient(135deg, #1e3a5f, #0b2f62); color: white; padding: 10px 24px; border-radius: 12px; font-weight: 600; border: none; cursor: pointer; transition: all 0.2s; }
.btn-save:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(11,47,98,0.3); }
.btn-cancel { background: #f1f5f9; color: #475569; padding: 10px 24px; border-radius: 12px; font-weight: 600; border: 1px solid #e2e8f0; cursor: pointer; transition: all 0.2s; }
.btn-cancel:hover { background: #e2e8f0; }
.btn-danger { background: #dc2626; color: white; padding: 10px 24px; border-radius: 12px; font-weight: 600; border: none; cursor: pointer; transition: all 0.2s; }
.btn-danger:hover { background: #b91c1c; transform: translateY(-2px); }

.toast { position: fixed; bottom: 30px; right: 30px; background: #10b981; color: white; padding: 14px 24px; border-radius: 12px; display: flex; align-items: center; gap: 12px; font-weight: 600; z-index: 2000; animation: slideInRight 0.3s ease; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1); }
.toast.hidden { display: none; }
@keyframes slideInRight { from { opacity: 0; transform: translateX(100px); } to { opacity: 1; transform: translateX(0); } }

.empty-state { text-align: center; padding: 60px 20px; }
.empty-icon { font-size: 64px; margin-bottom: 16px; opacity: 0.5; }
.empty-state p { color: #64748b; margin-bottom: 20px; }
.btn-add-small { background: linear-gradient(135deg, #1e3a5f, #0b2f62); color: white; padding: 10px 20px; border-radius: 10px; border: none; cursor: pointer; font-weight: 600; }

.pagination-container { margin-top: 32px; display: flex; flex-direction: column; align-items: center; gap: 16px; }
.pagination-info { font-size: 13px; color: #64748b; }
.pagination-links { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
.page-link-blue { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; padding: 0 12px; border-radius: 10px; background: #f8fafc; color: #334155; text-decoration: none; border: 1px solid #e2e8f0; transition: all 0.2s; }
.page-link-blue:hover { background: #e2e8f0; }
.page-link-blue.active { background: #0b2f62; color: white; border-color: #0b2f62; }
.page-link-blue.disabled { opacity: 0.5; pointer-events: none; }

@media (max-width: 980px) {
  .admin-main { margin-left: 0; width: 100%; }
  .stats-cards { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .stats-cards { grid-template-columns: 1fr; }
  .header-section { flex-direction: column; align-items: flex-start; }
  .form-row { grid-template-columns: 1fr; }
  .actions { flex-direction: column; }
  .modal-content { width: 95%; }
}
</style>

<script>
// ===== CUSTOM SELECT DROPDOWNS (scrollable, ouverture vers le haut) =====
document.addEventListener('DOMContentLoaded', () => {
  function initCustomSelects() {
    document.querySelectorAll('.custom-select').forEach(select => {
      const trigger = select.querySelector('.custom-select-trigger');
      const optionsDiv = select.querySelector('.custom-options');
      const hiddenInputId = select.dataset.target;
      const hiddenInput = document.getElementById(hiddenInputId);
      
      if (hiddenInput && !hiddenInput.value) {
        const defaultOption = select.querySelector('.custom-option');
        if (defaultOption) {
          hiddenInput.value = defaultOption.dataset.value;
          updateTriggerText(trigger, defaultOption);
        }
      }
      
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        document.querySelectorAll('.custom-select').forEach(s => {
          if (s !== select) s.classList.remove('open');
        });
        select.classList.toggle('open');
      });
      
      optionsDiv.querySelectorAll('.custom-option').forEach(opt => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const value = opt.dataset.value;
          if (hiddenInput) hiddenInput.value = value;
          updateTriggerText(trigger, opt);
          select.classList.remove('open');
        });
      });
    });
  }
  
  function updateTriggerText(trigger, selectedOpt) {
    trigger.innerHTML = selectedOpt.innerHTML;
  }
  
  document.addEventListener('click', () => {
    document.querySelectorAll('.custom-select').forEach(s => s.classList.remove('open'));
  });
  
  initCustomSelects();
});

// ===== TOAST ET MODALS =====
function showToast(msg, isError = false) {
  const toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.style.background = isError ? '#ef4444' : '#10b981';
  toast.classList.remove('hidden');
  setTimeout(() => toast.classList.add('hidden'), 3000);
}

const addModal = document.getElementById('addModal');
const editModal = document.getElementById('editModal');
const deleteModal = document.getElementById('deleteModal');

function closeModals() {
  addModal?.classList.remove('show');
  editModal?.classList.remove('show');
  deleteModal?.classList.remove('show');
}

document.getElementById('openAddModal')?.addEventListener('click', () => addModal.classList.add('show'));
document.getElementById('openAddModalEmpty')?.addEventListener('click', () => addModal.classList.add('show'));
document.querySelectorAll('.close-modal').forEach(btn => btn.addEventListener('click', closeModals));

// Ajout
document.getElementById('addForm')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const data = {
    nom: document.getElementById('addNom').value,
    telephone: document.getElementById('addTel').value,
    paysOrigine: document.getElementById('addOrigine').value,
    paysDestination: document.getElementById('addDestination').value
  };
  try {
    const res = await fetch('/transporteurs', { 
      method: 'POST', 
      headers: { 'Content-Type': 'application/json' }, 
      body: JSON.stringify(data) 
    });
    if (res.ok) { 
      showToast('✓ Transporteur ajouté avec succès'); 
      closeModals(); 
      setTimeout(() => location.reload(), 1000); 
    } else showToast('✗ Erreur lors de l\'ajout', true);
  } catch(err) { 
    showToast('✗ Erreur réseau', true); 
  }
});

// Modification
document.querySelectorAll('.btn-edit').forEach(btn => {
  btn.addEventListener('click', () => {
    const id = btn.dataset.id;
    const nom = btn.dataset.nom;
    const tel = btn.dataset.tel;
    const origine = btn.dataset.origine;
    const destination = btn.dataset.destination;
    
    document.getElementById('editId').value = id;
    document.getElementById('editNom').value = nom;
    document.getElementById('editTel').value = tel;
    document.getElementById('editOrigine').value = origine;
    document.getElementById('editDestination').value = destination;
    
    updateCustomSelectDisplay('editOrigine', origine);
    updateCustomSelectDisplay('editDestination', destination);
    
    editModal.classList.add('show');
  });
});

function updateCustomSelectDisplay(hiddenId, value) {
  const hidden = document.getElementById(hiddenId);
  if (!hidden) return;
  hidden.value = value;
  const customSelect = document.querySelector(`.custom-select[data-target="${hiddenId}"]`);
  if (customSelect) {
    const option = customSelect.querySelector(`.custom-option[data-value="${value}"]`);
    if (option) {
      const trigger = customSelect.querySelector('.custom-select-trigger');
      trigger.innerHTML = option.innerHTML;
    }
  }
}

document.getElementById('editForm')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const id = document.getElementById('editId').value;
  const data = {
    nom: document.getElementById('editNom').value,
    telephone: document.getElementById('editTel').value,
    paysOrigine: document.getElementById('editOrigine').value,
    paysDestination: document.getElementById('editDestination').value
  };
  try {
    const res = await fetch(`/transporteurs/${id}/update`, { 
      method: 'POST', 
      headers: { 'Content-Type': 'application/json' }, 
      body: JSON.stringify(data) 
    });
    if (res.ok) { 
      showToast('✓ Transporteur modifié avec succès'); 
      closeModals(); 
      setTimeout(() => location.reload(), 1000); 
    } else showToast('✗ Erreur lors de la modification', true);
  } catch(err) { 
    showToast('✗ Erreur réseau', true); 
  }
});

// Suppression
let deleteId = null;
document.querySelectorAll('.btn-delete').forEach(btn => {
  btn.addEventListener('click', () => {
    deleteId = btn.dataset.id;
    document.getElementById('deleteNom').textContent = btn.dataset.nom;
    deleteModal.classList.add('show');
  });
});

document.getElementById('confirmDelete')?.addEventListener('click', async () => {
  try {
    const res = await fetch(`/transporteurs/${deleteId}/delete`, { 
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    if (res.ok) { 
      showToast('✓ Transporteur supprimé avec succès'); 
      closeModals(); 
      setTimeout(() => location.reload(), 1000); 
    } else showToast('✗ Erreur lors de la suppression', true);
  } catch(err) { 
    showToast('✗ Erreur réseau', true); 
  }
});

window.onclick = (e) => { if (e.target.classList.contains('modal')) closeModals(); };
</script>