<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/3.5.0/css/flag-icon.min.css">


<% const currentDirection = (typeof direction !== 'undefined' && direction) ? direction : 'MA-FR'; %>
<div class="admin-page">
  <%- include('../partials/admin-navbar', { currentPage: 'transporteurs' }) %>

  <main class="admin-main">
    <div class="content-wrapper">
      <div class="header-section">
        <div class="header-title">
          <h1>🚚 Gestion des transporteurs</h1>
          <p class="header-subtitle">Gérez les transporteurs pour les livraisons internationales</p>
        </div>
        <button class="btn-add" id="openAddModal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          Ajouter un transporteur
        </button>
      </div>

      <div class="stats-cards">
        <div class="stat-card">
          <div class="stat-icon">🚚</div>
          <div class="stat-info">
            <span class="stat-number"><%= transporteurs ? transporteurs.length : 0 %></span>
            <span class="stat-label">Transporteurs</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon"><span class="flag-icon flag-icon-ma"></span></div>
          <div class="stat-info">
            <span class="stat-number"><%= transporteurs ? transporteurs.filter(t => t.paysOrigine === 'MA').length : 0 %></span>
            <span class="stat-label">Maroc</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon"><span class="flag-icon flag-icon-fr"></span></div>
          <div class="stat-info">
            <span class="stat-number"><%= transporteurs ? transporteurs.filter(t => t.paysOrigine === 'FR').length : 0 %></span>
            <span class="stat-label">France</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">🌍</div>
          <div class="stat-info">
            <span class="stat-number"><%= transporteurs ? transporteurs.filter(t => t.paysOrigine !== 'MA' && t.paysOrigine !== 'FR').length : 0 %></span>
            <span class="stat-label">Autres</span>
          </div>
        </div>
      </div>

      <div class="table-container">
        <div class="table-header">
          <span class="table-title">📋 Liste des transporteurs</span>
          <span class="table-count"><%= transporteurs ? transporteurs.length : 0 %> transporteur(s)</span>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Nom</th>
              <th>Téléphone</th>
              <th>Pays origine</th>
              <th>Pays destination</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (transporteurs && transporteurs.length > 0) { %>
              <% transporteurs.forEach(transporteur => { 
                // Mapping pour obtenir le bon code flag-icon (ex: GB -> gb)
                const flagMap = {
                  'MA': 'ma', 'FR': 'fr', 'ES': 'es', 'IT': 'it', 'DE': 'de',
                  'BE': 'be', 'CH': 'ch', 'NL': 'nl', 'GB': 'gb'
                };
                const codeOrig = flagMap[transporteur.paysOrigine] || 'un';
                const codeDest = flagMap[transporteur.paysDestination] || 'un';
              %>
              <tr>
                  <td class="cell-nom"><%= transporteur.nom %></td>
                  <td class="cell-tel"><%= transporteur.telephone %></td>
                  <td>
                    <span class="country-badge <%= transporteur.paysOrigine === 'MA' ? 'badge-ma' : transporteur.paysOrigine === 'FR' ? 'badge-fr' : 'badge-other' %>">
                      <span class="flag-icon flag-icon-<%= codeOrig %>"></span>
                      <%= transporteur.paysOrigine === 'MA' ? 'Maroc' : transporteur.paysOrigine === 'FR' ? 'France' : transporteur.paysOrigine %>
                    </span>
                  </td>
                  <td>
                    <span class="country-badge <%= transporteur.paysDestination === 'MA' ? 'badge-ma' : transporteur.paysDestination === 'FR' ? 'badge-fr' : 'badge-other' %>">
                      <span class="flag-icon flag-icon-<%= codeDest %>"></span>
                      <%= transporteur.paysDestination === 'MA' ? 'Maroc' : transporteur.paysDestination === 'FR' ? 'France' : transporteur.paysDestination %>
                    </span>
                   </td>
                  <td class="actions">
                    <button class="btn-edit" data-id="<%= transporteur._id %>" data-nom="<%= transporteur.nom %>" data-tel="<%= transporteur.telephone %>" data-origine="<%= transporteur.paysOrigine %>" data-destination="<%= transporteur.paysDestination %>">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 3l4 4-7 7H10v-4l7-7z"/>
                        <path d="M4 20h16"/>
                      </svg>
                      Modifier
                    </button>
                    <button class="btn-delete" data-id="<%= transporteur._id %>" data-nom="<%= transporteur.nom %>">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 7h16M10 11v6M14 11v6M5 7l1 12h12l1-12"/>
                        <path d="M9 3h6v4H9z"/>
                      </svg>
                      Supprimer
                    </button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr class="empty-row">
                <td colspan="5">
                  <div class="empty-state">
                    <div class="empty-icon">🚚</div>
                    <p>Aucun transporteur enregistré</p>
                    <button class="btn-add-small" id="openAddModalEmpty">+ Ajouter un transporteur</button>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if (pagination && pagination.totalPages > 1) { %>
        <div class="pagination-container">
          <div class="pagination-info">
            Affichage <%= (pagination.page - 1) * pagination.limit + 1 %> - 
            <%= Math.min(pagination.page * pagination.limit, pagination.totalItems) %> 
            sur <%= pagination.totalItems %> transporteur(s)
          </div>
          <div class="pagination-links">
            <% if (pagination.prevPage) { %>
              <a href="?page=<%= pagination.prevPage %>" class="page-link-blue">← Précédent</a>
            <% } else { %>
              <span class="page-link-blue disabled">← Précédent</span>
            <% } %>

            <% for (let i = 1; i <= pagination.totalPages; i++) { %>
              <% if (i === pagination.page) { %>
                <span class="page-link-blue active"><%= i %></span>
              <% } else { %>
                <a href="?page=<%= i %>" class="page-link-blue"><%= i %></a>
              <% } %>
            <% } %>

            <% if (pagination.nextPage) { %>
              <a href="?page=<%= pagination.nextPage %>" class="page-link-blue">Suivant →</a>
            <% } else { %>
              <span class="page-link-blue disabled">Suivant →</span>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </main>
</div>

<!-- Modal Ajout -->
<div id="addModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 12v8H4v-8M12 2v12m-4-4l4 4 4-4"/>
        </svg>
        Ajouter un transporteur
      </h2>
      <button class="modal-close close-modal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="modal-body-form">
      <form id="addForm">
        <div class="form-group">
          <label>Nom du transporteur</label>
          <input type="text" id="addNom" placeholder="Ex: Transport Express" required>
        </div>
        <div class="form-group">
          <label>Téléphone</label>
          <input type="text" id="addTel" placeholder="+212 6XX XXX XXX" required>
        </div>
        <div class="form-row">
          <div class="form-group custom-select-group">
            <label>Pays d'origine</label>
            <div class="custom-select" data-target="addOrigine">
              <div class="custom-select-trigger">
                <span class="flag-icon flag-icon-ma"></span> <span>Maroc</span>
              </div>
              <div class="custom-options">
                <div class="custom-option" data-value="MA"><span class="flag-icon flag-icon-ma"></span> Maroc</div>
                <div class="custom-option" data-value="FR"><span class="flag-icon flag-icon-fr"></span> France</div>
                <div class="custom-option" data-value="ES"><span class="flag-icon flag-icon-es"></span> Espagne</div>
                <div class="custom-option" data-value="IT"><span class="flag-icon flag-icon-it"></span> Italie</div>
                <div class="custom-option" data-value="DE"><span class="flag-icon flag-icon-de"></span> Allemagne</div>
                <div class="custom-option" data-value="BE"><span class="flag-icon flag-icon-be"></span> Belgique</div>
                <div class="custom-option" data-value="CH"><span class="flag-icon flag-icon-ch"></span> Suisse</div>
                <div class="custom-option" data-value="NL"><span class="flag-icon flag-icon-nl"></span> Pays-Bas</div>
                <div class="custom-option" data-value="GB"><span class="flag-icon flag-icon-gb"></span> Royaume-Uni</div>
              </div>
            </div>
            <input type="hidden" id="addOrigine" value="MA">
          </div>
          <div class="form-group custom-select-group">
            <label>Pays de destination</label>
            <div class="custom-select" data-target="addDestination">
              <div class="custom-select-trigger">
                <span class="flag-icon flag-icon-fr"></span> <span>France</span>
              </div>
              <div class="custom-options">
                <div class="custom-option" data-value="MA"><span class="flag-icon flag-icon-ma"></span> Maroc</div>
                <div class="custom-option" data-value="FR"><span class="flag-icon flag-icon-fr"></span> France</div>
                <div class="custom-option" data-value="ES"><span class="flag-icon flag-icon-es"></span> Espagne</div>
                <div class="custom-option" data-value="IT"><span class="flag-icon flag-icon-it"></span> Italie</div>
                <div class="custom-option" data-value="DE"><span class="flag-icon flag-icon-de"></span> Allemagne</div>
                <div class="custom-option" data-value="BE"><span class="flag-icon flag-icon-be"></span> Belgique</div>
                <div class="custom-option" data-value="CH"><span class="flag-icon flag-icon-ch"></span> Suisse</div>
                <div class="custom-option" data-value="NL"><span class="flag-icon flag-icon-nl"></span> Pays-Bas</div>
                <div class="custom-option" data-value="GB"><span class="flag-icon flag-icon-gb"></span> Royaume-Uni</div>
              </div>
            </div>
            <input type="hidden" id="addDestination" value="FR">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-cancel close-modal">Annuler</button>
          <button type="submit" class="btn-save">Enregistrer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Modification -->
<div id="editModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 3l4 4-7 7H10v-4l7-7z"/>
        </svg>
        Modifier le transporteur
      </h2>
      <button class="modal-close close-modal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
