  @media (max-width: 980px) {
    .admin-page {
      grid-template-columns: 1fr;
    }

    .admin-sidebar {
      position: relative;
      top: auto;
    }

    .admin-main {
      border-radius: 20px;
    }
  }

  /* Toast Styles */
  .toast {
    position: fixed;
    top: 24px;
    right: 24px;
    background: #10b981;
    color: white;
    padding: 14px 20px;
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    font-size: 14px;
    z-index: 2000;
    animation: slideInRight 0.3s ease-out;
  }

  .toast.error {
    background: #ef4444;
  }

  .toast.hidden {
    display: none;
  }

  .toast-icon {
    font-size: 18px;
    font-weight: bold;
  }

  .toast-message {
    flex: 1;
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(100px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideOutRight {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(100px);
    }
  }

  .toast.hide {
    animation: slideOutRight 0.3s ease-in;
  }
  /* ===== PAGINATION ===== */
.pagination-container {
  margin-top: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.pagination-info {
  font-size: 13px;
  color: #64748b;
}

.pagination-links {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
}

.page-link-blue {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 40px;
  height: 40px;
  padding: 0 12px;
  border-radius: 10px;
  background: #f8fafc;
  color: #334155;
  text-decoration: none;
  border: 1px solid #e2e8f0;
  transition: all 0.2s;
}

.page-link-blue:hover {
  background: #e2e8f0;
}

.page-link-blue.active {
  background: #0b2f62;
  color: white;
  border-color: #0b2f62;
}

.page-link-blue.disabled {
  opacity: 0.5;
  pointer-events: none;
}
/* ===== PANEL NOTIFICATIONS (dropdown) ===== */
.notification-panel {
  position: fixed;
  top: 100px;
  right: 24px;
  width: 320px;
  max-height: 480px;
  background: white;
  border-radius: 20px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15), 0 5px 12px rgba(0, 0, 0, 0.1);
  z-index: 1100;
  overflow: hidden;
  transition: all 0.2s ease;
  border: 1px solid #e5e7eb;
}

.notification-panel.hidden {
  display: none;
}

.notification-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 18px;
  background: #0d3b66;
  color: white;
  font-weight: 600;
  font-size: 14px;
}

.close-panel-btn {
  background: none;
  border: none;
  color: white;
  font-size: 18px;
  cursor: pointer;
  line-height: 1;
  opacity: 0.8;
}

.close-panel-btn:hover {
  opacity: 1;
}

.notification-panel-body {
  max-height: 400px;
  overflow-y: auto;
}

.notification-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 16px;
 
 
 
 
  border-bottom: 1px solid #f0f2f5;
  transition: background 0.15s;
  text-decoration: none;
}

.notification-item:hover {
  background: #f8fafc;
}

.notif-icon {
  font-size: 24px;
  min-width: 36px;
  text-align: center;
}

.notif-content {
  flex: 1;
}

.notif-title {
  font-weight: 700;
  font-size: 14px;
  color: #0f172a;
  margin-bottom: 4px;
}

.notif-message {
  font-size: 13px;
  color: #475569;
  margin-bottom: 6px;
  line-height: 1.35;
}

.notif-date {
  font-size: 11px;
  color: #94a3b8;
}

.notification-empty {
  text-align: center;
  padding: 40px 20px;
  color: #94a3b8;
}

.notification-empty span {
  font-size: 40px;
  display: block;
  margin-bottom: 12px;
}
</style>

<script>
  // Toast Notification Function
  function showToast(message, isError = false, duration = 3000) {
    const toast = document.getElementById('toast');
    const toastMessage = document.getElementById('toastMessage');
    const toastIcon = toast.querySelector('.toast-icon');
    
    toastMessage.textContent = message;
    toast.classList.remove('hidden', 'hide', 'error');
    
    if (isError) {
      toast.classList.add('error');
      toastIcon.textContent = '✕';
    } else {
      toastIcon.textContent = '✓';
    }
    
    toast.classList.remove('hidden');
    
    setTimeout(() => {
      toast.classList.add('hide');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 300);
    }, duration);
  }

  const notificationIcon = document.getElementById('notificationIcon');
  const notificationPanel = document.getElementById('notificationPanel');
  const closeNotificationPanel = document.getElementById('closeNotificationPanel');

  if (notificationIcon && notificationPanel) {
    notificationIcon.addEventListener('click', () => {
      notificationPanel.classList.toggle('hidden');
    });
  }

  if (closeNotificationPanel && notificationPanel) {
    closeNotificationPanel.addEventListener('click', () => {
      notificationPanel.classList.add('hidden');
    });
  }

  document.addEventListener('click', (event) => {
    if (
      notificationPanel &&
      !notificationPanel.classList.contains('hidden') &&
      !notificationPanel.contains(event.target) &&
      notificationIcon &&
      !notificationIcon.contains(event.target)
    ) {
      notificationPanel.classList.add('hidden');
    }
  });

  const editModal = document.getElementById('editModal');
  const editModalCloseBtn = document.getElementById('editModalCloseBtn');
  const editModalCancelBtn = document.getElementById('editModalCancelBtn');
  const editModalOverlay = editModal.querySelector('.modal-overlay');
  const editForm = document.getElementById('editForm');
  const editButtons = document.querySelectorAll('.btn-edit');

  // Delete Modal Management
  const deleteModal = document.getElementById('deleteModal');
  const deleteModalCloseBtn = document.getElementById('deleteModalCloseBtn');
  const deleteModalCancelBtn = document.getElementById('deleteModalCancelBtn');
  const deleteModalConfirmBtn = document.getElementById('deleteModalConfirmBtn');
  const deleteModalOverlay = deleteModal.querySelector('.modal-overlay');
  const deleteButtons = document.querySelectorAll('.btn-delete');
  let currentDeleteOrderId = null;
  let currentDeleteOrderNumber = null;

  // Open Edit Modal
  function openEditModal(button) {
    const orderId = button.dataset.orderId;
    const orderPaid = button.dataset.orderPaid === 'true';
    const orderStatus = button.dataset.orderStatus;
    const senderName = button.dataset.senderName || '';
    const receiverName = button.dataset.receiverName || '';
    const senderCity = button.dataset.senderCity || '';
    const receiverCity = button.dataset.receiverCity || '';
    const paidAmount = button.dataset.paidAmount || '';

    // Fill all fields
    document.getElementById('senderName').value = senderName;
    document.getElementById('receiverName').value = receiverName;
    document.getElementById('senderCity').value = senderCity;
    document.getElementById('receiverCity').value = receiverCity;
    document.getElementById('statusSelect').value = orderStatus;
    document.getElementById('paidSelect').value = orderPaid ? 'true' : 'false';
    document.getElementById('paidAmount').value = paidAmount;
    
    editForm.dataset.orderId = orderId;

    editModal.classList.remove('hidden');
  }

  // Close Edit Modal
  function closeEditModal() {
    editModal.classList.add('hidden');
  }

  // Open Delete Modal
  function openDeleteModal(button) {
    currentDeleteOrderId = button.dataset.orderId;
    currentDeleteOrderNumber = button.dataset.orderNumber;
    const confirmText = document.getElementById('deleteConfirmText');
    confirmText.textContent = `Êtes-vous sûr de vouloir supprimer le colis N° ${currentDeleteOrderNumber} ? Cette action est irréversible.`;
    deleteModal.classList.remove('hidden');
  }

  // Close Delete Modal
  function closeDeleteModal() {
    deleteModal.classList.add('hidden');
    currentDeleteOrderId = null;
    currentDeleteOrderNumber = null;
  }

  // Edit Modal Event Listeners
  editButtons.forEach(btn => {
    btn.addEventListener('click', () => openEditModal(btn));
  });

  editModalCloseBtn.addEventListener('click', closeEditModal);
  editModalCancelBtn.addEventListener('click', closeEditModal);
  editModalOverlay.addEventListener('click', closeEditModal);
  editForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const orderId = editForm.dataset.orderId;
    const formData = new FormData(editForm);
    
    const data = {};
    
    // Ajouter uniquement les champs non-vides
    const senderName = formData.get('senderName');
    if (senderName) data.senderName = senderName;
    
    const receiverName = formData.get('receiverName');
    if (receiverName) data.receiverName = receiverName;
    
    const senderCity = formData.get('senderCity');
    if (senderCity) data.senderCity = senderCity;
    
    const receiverCity = formData.get('receiverCity');
    if (receiverCity) data.receiverCity = receiverCity;
    
    const status = formData.get('status');
    if (status) data.status = status;
    
    const paid = formData.get('paid');
    if (paid) data.paid = paid === 'true';
    
    const paidAmount = formData.get('paidAmount');
    if (paidAmount) data.paidAmount = parseFloat(paidAmount);

    console.log('Form Data to Send:', data);

    try {
      const res = await fetch(`/orders/${orderId}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify(data)
      });

      if (res.ok) {
        closeEditModal();
        showToast('✓ Modification avec succès', false);
        setTimeout(() => location.reload(), 2000);
      } else {
        const errorData = await res.json();
        console.error('Error Response:', errorData);
        showToast('Erreur: ' + (errorData.error || errorData.details || 'Erreur inconnue'), true, 4000);
      }
    } catch (err) {
      console.error('Erreur:', err);
      showToast('Erreur lors de la mise à jour: ' + err.message, true, 4000);
    }
  });

  // Delete Modal Event Listeners
  deleteButtons.forEach(btn => {
    btn.addEventListener('click', () => openDeleteModal(btn));
  });

  deleteModalCloseBtn.addEventListener('click', closeDeleteModal);
  deleteModalCancelBtn.addEventListener('click', closeDeleteModal);
  deleteModalOverlay.addEventListener('click', closeDeleteModal);
  deleteModalConfirmBtn.addEventListener('click', async () => {
    if (!currentDeleteOrderId) return;

    try {
      console.log('Deleting order:', currentDeleteOrderId);
      
      const res = await fetch(`/orders/${currentDeleteOrderId}`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        }
      });

      console.log('Delete response status:', res.status);
      
      if (res.ok) {
        closeDeleteModal();
        showToast('✓ Suppression avec succès', false);
        setTimeout(() => location.reload(), 2000);
      } else {
        const errorData = await res.json();
        console.error('Delete error response:', errorData);
        showToast('Erreur: ' + (errorData.error || 'Erreur inconnue'), true, 4000);
      }
    } catch (err) {
      console.error('Delete fetch error:', err);
      showToast('Erreur réseau: ' + err.message, true, 4000);
    }
  });

  // Close modal when pressing Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeEditModal();
      closeDeleteModal();
    }
  });
</script>
