<%- include('partials/header') %>
<% const currentDirection = (typeof direction !== 'undefined' && direction) ? direction : 'MA-FR'; %>
<% const stats = {
  totalOrders: typeof totalOrders !== 'undefined' ? totalOrders : 0,
  inTransit: typeof inTransit !== 'undefined' ? inTransit : 0,
  delivered: typeof delivered !== 'undefined' ? delivered : 0,
  totalClients: typeof totalClients !== 'undefined' ? totalClients : 0,
}; %>
<% const safeNotificationCount = typeof notificationCount !== 'undefined' ? notificationCount : 0; %>
<% const safeNotifications = Array.isArray(notifications) ? notifications : []; %>

<div class="admin-page">
  <%- include('partials/admin-navbar', { currentPage: 'dashboard' }) %>

  <main class="admin-main">
   <header class="admin-topbar">
  <div>
    <h1>Tableau de bord</h1>
  </div>
  <div class="admin-topbar-actions">
    <button id="notificationIcon" class="notification-bell" type="button" aria-label="Ouvrir notifications">
            🔔
            <% if (safeNotificationCount > 0) { %>
              <span class="notification-badge"><%= safeNotificationCount %></span>
            <% } %>
          </button>
  </div>
</header>
        
    <section class="stats-cards">
      <div class="card stat-card">
        <div class="stat-title">Total colis</div>
        <div class="stat-value"><%= stats.totalOrders %></div>
      </div>
      <div class="card stat-card">
        <div class="stat-title">En transit</div>
        <div class="stat-value"><%= stats.inTransit %></div>
      </div>
      <div class="card stat-card">
        <div class="stat-title">Livrés</div>
        <div class="stat-value"><%= stats.delivered %></div>
      </div>
      <div class="card stat-card">
        <div class="stat-title">Clients</div>
        <div class="stat-value"><%= stats.totalClients %></div>
      </div>
    </section>

    <section class="quick-actions">
      <a href="/orders/new" class="action-card">
        <span class="action-icon">➕</span>
        <span>Ajouter colis</span>
      </a>
      <a href="/orders" class="action-card">
        <span class="action-icon">📄</span>
        <span>Liste colis</span>
      </a>
      <a href="/clients" class="action-card">
        <span class="action-icon">👥</span>
        <span>Clients</span>
      </a>
      <a href="/cities" class="action-card">
        <span class="action-icon">📍</span>
        <span>Villes</span>
      </a>
    </section>

    <section class="recent-orders">
      <div class="section-header">
        <div class="section-title-row">
          <h2>Colis récents</h2>
         
          
        </div>
        <a href="/orders" class="link">Voir tout →</a>
      </div>

      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>N° Colis</th>
              <th>Expéditeur</th>
              <th>Destinataire</th>
  
              <th>Trajet</th>
              <th>Payé</th>
              <th>Statut</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% recentOrders.forEach(order => { %>
              <tr>
                <td><strong><%= order.orderNumber %></strong></td>
                <td><%= order.senderName || '-' %></td>
                <td><%= order.receiverName || '—' %></td>
             
                <td className="trajet-cell"><span class="trajet-badge"><%= order.senderCity || (order.fromCity ? order.fromCity.name : '—') %></span> <span class="arrow">→</span> <span class="trajet-badge"><%= order.receiverCity || (order.toCity ? order.toCity.name : '—') %></span></td>
                <td>
                  <% if (order.paid) { %>
                    <span class="badge badge-success">Payé ✓</span>
                  <% } else { %>
                    <span class="badge badge-warning">Non payé</span>
                  <% } %>
                </td>
                <td>
                  <% if (order.status === 'delivered') { %>
                    <span class="badge badge-success">Livré</span>
                  <% } else if (order.status === 'shipped') { %>
                    <span class="badge badge-primary">Expédié</span>
                  <% } else { %>
                    <span class="badge badge-muted">En attente</span>
                  <% } %>
                </td>
                <td>
                  <div class="action-buttons">
                    <button class="btn-action btn-edit" 
                      data-order-id="<%= order._id %>" 
                      data-order-paid="<%= order.paid %>" 
                      data-order-status="<%= order.status %>"
                      data-sender-name="<%= order.senderName %>"
                      data-receiver-name="<%= order.receiverName %>"
                      data-sender-city="<%= order.senderCity %>"
                      data-receiver-city="<%= order.receiverCity %>"
                      data-paid-amount="<%= order.paidAmount %>">✏️ </button>
                    <button class="btn-action btn-delete" data-order-id="<%= order._id %>" data-order-number="<%= order.orderNumber %>">🗑️</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Modal for editing order -->
      <div id="editModal" class="modal hidden">
        <div class="modal-overlay"></div>
        <div class="modal-content">
          <div class="modal-header">
            <h2 id="modalTitle">Modifier le colis</h2>
            <button class="modal-close" id="editModalCloseBtn">✕</button>
          </div>
          <div class="modal-body">
            <form id="editForm" method="POST">
              <input type="hidden" name="_method" value="PUT">
              
              <div style="max-height: 420px; overflow-y: auto; padding-right: 8px;">
                <h3 style="margin: 0 0 12px; color: #0d3b66; font-size: 14px; font-weight: 600;">Expéditeur</h3>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                  <div class="form-group" style="margin-bottom: 0;">
                    <label>Nom</label>
                    <input type="text" name="senderName" id="senderName" placeholder="Nom">
                  </div>
                  <div class="form-group" style="margin-bottom: 0;">
                    <label>Ville</label>
                    <input type="text" name="senderCity" id="senderCity" placeholder="Ville">
                  </div>
                </div>

                <h3 style="margin: 16px 0 12px; color: #0d3b66; font-size: 14px; font-weight: 600;">Destinataire</h3>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                  <div class="form-group" style="margin-bottom: 0;">
                    <label>Nom</label>
                    <input type="text" name="receiverName" id="receiverName" placeholder="Nom">
                  </div>
                  <div class="form-group" style="margin-bottom: 0;">
                    <label>Ville</label>
                    <input type="text" name="receiverCity" id="receiverCity" placeholder="Ville">
                  </div>
                </div>

                <h3 style="margin: 16px 0 12px; color: #0d3b66; font-size: 14px; font-weight: 600;">Colis</h3>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                  <div class="form-group" style="margin-bottom: 0;">
                    <label>Statut</label>
                    <select name="status" id="statusSelect" required>
                      <option value="">Sélectionnez</option>
                      <option value="pending">En attente</option>
                      <option value="shipped">Expédié</option>
                      <option value="delivered">Livré</option>
                    </select>
                  </div>
                  <div class="form-group" style="margin-bottom: 0;">
                    <label>Paiement</label>
                    <select name="paid" id="paidSelect" required>
                      <option value="">Sélectionnez</option>
                      <option value="false">Non payé</option>
                      <option value="true">Payé</option>
                    </select>
                  </div>
                </div>

                <div class="form-group">
                  <label>Montant payé</label>
                  <input type="number" name="paidAmount" id="paidAmount" min="0" step="0.01" placeholder="0.00">
                </div>
              </div>

              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="editModalCancelBtn">Annuler</button>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Modal for delete confirmation -->
      <div id="deleteModal" class="modal hidden">
        <div class="modal-overlay"></div>
        <div class="modal-content">
          <div class="modal-header">
            <h2>Confirmer la suppression</h2>
            <button class="modal-close" id="deleteModalCloseBtn">✕</button>
          </div>
          <div class="modal-body">
            <p id="deleteConfirmText" style="margin: 0; color: #374151; line-height: 1.5;"></p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="deleteModalCancelBtn">Annuler</button>
            <button type="button" class="btn btn-danger" id="deleteModalConfirmBtn" style="background: #dc2626; color: white;">Supprimer</button>
          </div>
        </div>
      </div>
    </section>
        <!-- Pagination -->
    <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
      <div class="pagination-container">
        <div class="pagination-info">
          Affichage <%= (pagination.page - 1) * pagination.limit + 1 %> - 
          <%= Math.min(pagination.page * pagination.limit, pagination.totalItems) %> 
          sur <%= pagination.totalItems %> colis
        </div>
        <div class="pagination-links">
          <% if (pagination.prevPage) { %>
            <a href="?page=<%= pagination.prevPage %>" class="page-link-blue">← Précédent</a>
          <% } else { %>
            <span class="page-link-blue disabled">← Précédent</span>
          <% } %>

          <% for (let i = 1; i <= pagination.totalPages; i++) { %>
            <% if (i === pagination.page) { %>
              <span class="page-link-blue active"><%= i %></span>
            <% } else { %>
              <a href="?page=<%= i %>" class="page-link-blue"><%= i %></a>
            <% } %>
          <% } %>

          <% if (pagination.nextPage) { %>
            <a href="?page=<%= pagination.nextPage %>" class="page-link-blue">Suivant →</a>
          <% } else { %>
            <span class="page-link-blue disabled">Suivant →</span>
          <% } %>
        </div>
      </div>
    <% } %>
 <div id="notificationPanel" class="notification-panel hidden">
  <div class="notification-panel-header">
    <h3>🔔 Notifications</h3>
  </div>
  <div class="notification-panel-body">
    <% if (safeNotifications.length > 0) { %>
      <% safeNotifications.forEach(notif => { %>
        <% if (notif.href) { %>
          <a class="notification-item" href="<%= notif.href %>">
            <div class="notif-icon"><%= notif.icon || '📦' %></div>
            <div class="notif-content">
              <div class="notif-title"><%= notif.title %></div>
              <div class="notif-message"><%= notif.message %></div>
              <div class="notif-date"><%= notif.date %></div>
            </div>
          </a>
        <% } else { %>
          <div class="notification-item">
            <div class="notif-icon"><%= notif.icon || '📦' %></div>
            <div class="notif-content">
              <div class="notif-title"><%= notif.title %></div>
              <div class="notif-message"><%= notif.message %></div>
              <div class="notif-date"><%= notif.date %></div>
            </div>
          </div>
        <% } %>
      <% }) %>
    <% } else { %>
      <div class="notification-empty">
        <span>📭</span>
        <p>Aucune notification</p>
      </div>
    <% } %>
  </div>
</div>
  </main>
</div>

<!-- Toast Notification -->
<div id="toast" class="toast hidden">
  <div class="toast-content">
    <span class="toast-icon"></span>
    <span class="toast-message" id="toastMessage"></span>
  </div>
</div>

<style>

  /* Style spécifique pour transformer le bouton de formulaire en lien de sidebar */

  /* Hide global top bar navigation on the admin dashboard */
  .topbar { display: none !important; }

  .admin-page {
  display: flex;
  min-height: 100vh;
}



.admin-main {
  margin-left: 280px;
  flex: 1;
  padding: 24px 32px;
  background: #f2f7ff;
  min-height: 100vh;
  width: calc(100% - 20px);
}

  .admin-topbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 22px;
   
    margin-top: -5px;
    
  }

  .admin-topbar h1 {
    margin: 0;
    font-size: 28px;
    font-weight: 800;
  }

  .section-title-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

 /* Conteneur principal (bouton cloche) */
