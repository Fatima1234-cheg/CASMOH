<%- include('../partials/header') %>

<section class="auth-page">
  <div class="auth-split-wrap">

    <!-- LEFT PANEL -->
    <div class="auth-left">
      <div class="auth-truck">
      
      <img src="/public/img/logocamion.png" width="170" height="100" alt="CASMOH Logo"/>
    
      </div>
      <h2 class="auth-left-title">Déjà membre<br>CASMOH ?</h2>
      <p class="auth-left-sub">Connectez-vous pour suivre<br>vos envois en temps réel.</p>
      
    </div>

    <!-- RIGHT PANEL -->
    <div class="auth-right">
      <h1 class="auth-form-title">Créer un compte</h1>
      <p class="auth-form-sub">Rejoignez CASMOH en quelques secondes.</p>

      <% if (errors && errors.length) { %>
        <div class="auth-alert">
          <% errors.forEach(e => { %><div><%= e.msg %></div><% }) %>
        </div>
      <% } %>

      <form method="POST" action="/auth/register" class="auth-form">

        <div class="auth-field">
          <label>Nom complet</label>
          <div class="auth-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            <input type="text" name="fullname" placeholder="Votre nom complet" value="<%= (old && old.fullname) || '' %>" required>
          </div>
        </div>

        <div class="auth-field">
          <label>Email</label>
          <div class="auth-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="M2 7l10 7 10-7"/></svg>
            <input type="email" name="email" placeholder="votre@email.com" value="<%= (old && old.email) || '' %>" required>
          </div>
        </div>

        <div class="auth-field">
          <label>Numéro de téléphone</label>
          <div class="auth-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <input type="tel" name="phone" placeholder="Votre numéro de téléphone" value="<%= (old && old.phone) || '' %>">
          </div>
        </div>

        <div class="auth-field">
          <label>Mot de passe</label>
          <div class="auth-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input type="password" name="password" placeholder="••••••••" required>
          </div>
        </div>

        <div class="auth-field">
          <label>Confirmer le mot de passe</label>
          <div class="auth-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input type="password" name="confirmPassword" placeholder="••••••••" required>
          </div>
        </div>

        <button class="auth-submit" type="submit">Créer un compte</button>

        <% if (locals.oauth && (locals.oauth.google || locals.oauth.facebook)) { %>
          <div class="auth-divider"><span>ou continuer avec</span></div>
          <div class="auth-socials">
            <% if (locals.oauth.google) { %>
              <a href="/auth/google" class="social-btn g" aria-label="S'inscrire avec Google">G</a>
            <% } %>
            <% if (locals.oauth.facebook) { %>
              <a href="/auth/facebook" class="social-btn fb" aria-label="S'inscrire avec Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22 12.06C22 6.48 17.52 2 11.94 2S2 6.48 2 12.06c0 5 3.66 9.14 8.44 9.94v-7.03H7.9v-2.91h2.54V9.41c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.91h-2.34V22c4.78-.8 8.44-4.94 8.44-9.94z"/>
                </svg>
              </a>
            <% } %>
          </div>
        <% } %>

      </form>

      <p class="auth-switch">
        Déjà un compte ? <a href="/auth/login">Se connecter</a>
      </p>
    </div>

  </div>
</section>


