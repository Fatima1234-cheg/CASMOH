<%- include('../partials/header') %>

<section class="auth-page">
  <div class="auth-split-wrap">

    <!-- LEFT PANEL -->
  <div class="auth-left">
<div class="auth-truck">
  <svg width="320" height="190" viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg">
    <style>
      .p1 { animation: float1 3s ease-in-out infinite; }
      .p2 { animation: float2 3.8s ease-in-out infinite; }
      .p3 { animation: float3 2.6s ease-in-out infinite; }
      @keyframes float1 { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
      @keyframes float2 { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-7px)} }
      @keyframes float3 { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }
    </style>

    <!-- Grand paquet -->
    <g class="p1">
      <image href="/public/img/paquet1.png" x="4" y="-10" width="310" height="300"/>
    </g>

    <!-- Moyen paquet -->
    <g class="p2">
      <image href="/public/img/paquet1.png" x="120" y="20" width="270" height="210"/>
    </g>

    <!-- Petit paquet -->
    <g class="p3">
      <image href="/public/img/paquet1.png" x="-26" y="10" width="180" height="180"/>
    </g>

  </svg>
</div>
  <h2 class="auth-left-title">Bienvenue sur<br>CASMOH</h2>
  <p class="auth-left-sub">Transport de bagages non accompagnés<br>France ↔ Maroc</p>
</div>

    <!-- RIGHT PANEL -->
    <div class="auth-right">
      <h1 class="auth-form-title">Connexion</h1>
      <p class="auth-form-sub">Content de vous revoir !</p>

      <% if (errors && errors.length) { %>
        <div class="auth-alert">
          <% errors.forEach(e => { %><div><%= e.msg %></div><% }) %>
        </div>
      <% } %>

      <form method="POST" action="/auth/login" class="auth-form">

        <div class="auth-field">
          <label>Email</label>
          <div class="auth-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="M2 7l10 7 10-7"/></svg>
            <input type="email" name="email" placeholder="votre@email.com" value="<%= (old && old.email) || '' %>" required>
          </div>
        </div>

        <div class="auth-field">
          <label>Mot de passe</label>
          <div class="auth-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input type="password" name="password" placeholder="••••••••" required>
          </div>
        </div>

   <div class="auth-check-container">
  <input type="checkbox" id="remember" name="remember">
  <label for="remember" class="auth-check-label">Se souvenir de moi</label>
</div>

        <button class="auth-submit" type="submit">Se connecter</button>

        <% if (locals.oauth && (locals.oauth.google || locals.oauth.facebook)) { %>
          <div class="auth-divider"><span>ou continuer avec</span></div>
          <div class="auth-socials">
            <% if (locals.oauth.google) { %>
              <a href="/auth/google" class="social-btn g" aria-label="Se connecter avec Google">G</a>
            <% } %>
            <% if (locals.oauth.facebook) { %>
              <a href="/auth/facebook" class="social-btn fb" aria-label="Se connecter avec Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22 12.06C22 6.48 17.52 2 11.94 2S2 6.48 2 12.06c0 5 3.66 9.14 8.44 9.94v-7.03H7.9v-2.91h2.54V9.41c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.91h-2.34V22c4.78-.8 8.44-4.94 8.44-9.94z"/>
                </svg>
              </a>
            <% } %>
          </div>
        <% } %>

      </form>

      <p class="auth-switch">
        Pas encore de compte ? <a href="/auth/register">Créer un compte</a>
      </p>
    </div>

  </div>
</section>

