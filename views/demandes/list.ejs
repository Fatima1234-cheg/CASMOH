<script>
const demandToast = document.getElementById('demandToast');
const demandsCount = document.getElementById('demandsCount');
const deleteAllDemandsModal = document.getElementById('deleteAllDemandsModal');
const deleteAllDemandsCode = document.getElementById('deleteAllDemandsCode');
const deleteAllDemandsError = document.getElementById('deleteAllDemandsError');
const confirmDeleteAllDemands = document.getElementById('confirmDeleteAllDemands');
const cancelDeleteAllDemands = document.getElementById('cancelDeleteAllDemands');
const openDeleteAllDemands = document.getElementById('openDeleteAllDemands');
const toggleDeleteAllDemandsCode = document.getElementById('toggleDeleteAllDemandsCode');

async function readJsonResponse(response) {
  const contentType = response.headers.get('content-type') || '';
  if (contentType.includes('application/json')) {
    return response.json();
  }

  const rawText = await response.text();
  const looksLikeHtml = /^\s*</.test(rawText);
  return {
    success: false,
    error: looksLikeHtml ? 'Page non trouvee ou route indisponible' : (rawText || 'Erreur serveur')
  };
}

async function deleteDemandRequest(demandId) {
  const primaryResponse = await fetch(`/demandes/${demandId}`, {
    method: 'DELETE',
    headers: {
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'application/json'
    }
  });

  const primaryPayload = await readJsonResponse(primaryResponse);
  if (primaryResponse.ok && primaryPayload.success) {
    return { response: primaryResponse, payload: primaryPayload };
  }

  if (primaryResponse.status !== 404) {
    return { response: primaryResponse, payload: primaryPayload };
  }

  const fallbackResponse = await fetch(`/demandes/${demandId}/delete`, {
    method: 'POST',
    headers: {
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'application/json'
    }
  });
  const fallbackPayload = await readJsonResponse(fallbackResponse);
  return { response: fallbackResponse, payload: fallbackPayload };
}

async function deleteAllDemandsRequest(code) {
  const requestOptions = {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-Requested-With': 'XMLHttpRequest',
      'Accept': 'application/json'
    },
    body: JSON.stringify({ code })
  };

  const primaryResponse = await fetch('/demandes/reset-all', requestOptions);
  const primaryPayload = await readJsonResponse(primaryResponse);
  if (primaryResponse.ok && primaryPayload.success) {
    return { response: primaryResponse, payload: primaryPayload };
  }

  if (primaryResponse.status !== 404) {
    return { response: primaryResponse, payload: primaryPayload };
  }

  const fallbackResponse = await fetch('/demandes/delete-all', requestOptions);
  const fallbackPayload = await readJsonResponse(fallbackResponse);
  return { response: fallbackResponse, payload: fallbackPayload };
}

function showDemandToast(message, isError = false) {
  if (!demandToast) return;
  demandToast.textContent = message;
  demandToast.style.background = isError ? '#dc2626' : '#0f766e';
  demandToast.classList.remove('hidden');
  window.clearTimeout(showDemandToast.timer);
  showDemandToast.timer = window.setTimeout(() => {
    demandToast.classList.add('hidden');
  }, 2500);
}

function updateDemandsCount() {
  if (!demandsCount) return;
  const count = document.querySelectorAll('.demand-card').length;
  demandsCount.textContent = `${count} demande(s)`;
}

/**
 * Normalise un numéro de téléphone au format international pour WhatsApp.
 * - Supprime espaces, parenthèses, tirets, +, et tout caractère spécial
 * - Évite les doublons d'indicatifs (212212…, +212+212…)
 * - Direction MA-FR → indicatif 212 (client au Maroc)
 * - Direction FR-MA → indicatif 33  (client en France)
 */
function formatDemandPhoneForWhatsApp(phone, direction) {
  const raw = String(phone || '').trim();
  if (!raw) return '';

  // Indicatif par défaut selon la direction
  const defaultCC = (direction === 'FR-MA') ? '33' : '212';

  // Liste étendue d'indicatifs connus (triés du plus long au plus court pour matcher correctement)
  const knownCCs = ['213', '216', '212', '49', '44', '41', '39', '34', '33', '32', '31', '1'];

  // 1. Supprimer TOUT sauf les chiffres
  let digits = raw.replace(/[^0-9]/g, '');

  // 2. Supprimer le préfixe d'appel international « 00 »
  if (digits.startsWith('00')) {
    digits = digits.slice(2);
  }

  // 3. Détecter si le numéro original ressemblait à un format international
  const looksInternational = raw.startsWith('+') || raw.startsWith('00');

  // 4. Chercher un indicatif connu au début des chiffres
  const matchedCC = knownCCs.find(cc => digits.startsWith(cc));

  if (matchedCC && (looksInternational || digits.length >= 11)) {
    // Extraire la partie nationale, en supprimant les 0 de tête
    let national = digits.slice(matchedCC.length).replace(/^0+/, '');
    // Protection anti-doublon : si la partie nationale re-commence par le même indicatif, le retirer
    while (national.startsWith(matchedCC)) {
      national = national.slice(matchedCC.length).replace(/^0+/, '');
    }
    return national ? `${matchedCC}${national}` : '';
  }

  // 5. Si les chiffres commencent déjà par l'indicatif par défaut (sans +), retirer et reconstruire
  if (digits.startsWith(defaultCC)) {
    let national = digits.slice(defaultCC.length).replace(/^0+/, '');
    while (national.startsWith(defaultCC)) {
      national = national.slice(defaultCC.length).replace(/^0+/, '');
    }
    return national ? `${defaultCC}${national}` : '';
  }

  // 6. Numéro local : retirer le 0 de tête et préfixer avec l'indicatif par défaut
  digits = digits.replace(/^0+/, '');
  return digits ? `${defaultCC}${digits}` : '';
}

/**
 * Ouvre WhatsApp avec le protocole natif (whatsapp://send) et fallback wa.me.
 * Message prérempli selon les spécifications.
 */
function openWhatsAppForDemand(rawPhone, direction, fullName) {
  const phoneDigits = formatDemandPhoneForWhatsApp(rawPhone, direction);
  if (!phoneDigits) return false;

  const message = 'Bonjour, service Casmoh vous remercie pour votre confiance et vous informe que nous avons bien reçu votre demande. Nous vous répondrons et vous fixerons un rendez-vous bientôt';
  const encodedMessage = encodeURIComponent(message);

  // Tentative d'ouverture via protocole natif WhatsApp
  const nativeUrl = `whatsapp://send?phone=${phoneDigits}&text=${encodedMessage}`;
  const fallbackUrl = `https://wa.me/${phoneDigits}?text=${encodedMessage}`;

  // Tenter l'ouverture native, fallback après 1.5s si rien ne se passe
  const startTime = Date.now();
  const fallbackTimer = setTimeout(() => {
    // Si on est toujours sur la page après 1.5s, le protocole natif n'a pas fonctionné
    if (document.visibilityState !== 'hidden') {
      window.open(fallbackUrl, '_blank');
    }
  }, 1500);

  // Écouter si la page se masque (= l'app WhatsApp s'est ouverte)
  const handleVisibility = () => {
    clearTimeout(fallbackTimer);
    document.removeEventListener('visibilitychange', handleVisibility);
  };
  document.addEventListener('visibilitychange', handleVisibility);

  // Ouvrir via protocole natif
  window.location.href = nativeUrl;

  return true;
}

document.querySelectorAll('.demand-whatsapp').forEach((link) => {
  link.addEventListener('click', (event) => {
    event.preventDefault();

    const success = openWhatsAppForDemand(
      link.dataset.phone,
      link.dataset.direction,
      link.dataset.name
    );

    if (!success) {
      showDemandToast('Numéro de téléphone invalide', true);
    }
  });
});

function openDeleteAllModal() {
  if (!deleteAllDemandsModal) return;
  deleteAllDemandsModal.classList.remove('hidden');
  deleteAllDemandsModal.setAttribute('aria-hidden', 'false');
  deleteAllDemandsCode.value = '';
  deleteAllDemandsCode.type = 'password';
  if (toggleDeleteAllDemandsCode) {
    toggleDeleteAllDemandsCode.querySelector('.eye-open')?.classList.remove('hidden');
    toggleDeleteAllDemandsCode.querySelector('.eye-closed')?.classList.add('hidden');
  }
  deleteAllDemandsError.classList.add('hidden');
  window.setTimeout(() => deleteAllDemandsCode.focus(), 50);
}

function closeDeleteAllModal() {
  if (!deleteAllDemandsModal) return;
  deleteAllDemandsModal.classList.add('hidden');
  deleteAllDemandsModal.setAttribute('aria-hidden', 'true');
}

document.querySelectorAll('.demand-delete-icon').forEach((button) => {
  button.addEventListener('click', async () => {
    const demandId = button.dataset.demandId;
    const card = button.closest('.demand-card');
    if (!demandId || !card) return;

    const isConfirmed = window.confirm('Vous etes sure de supprimer cette demande ?');
    if (!isConfirmed) return;

    try {
      const { response, payload } = await deleteDemandRequest(demandId);

      if (!response.ok || !payload.success) {
        showDemandToast(payload.error || 'Erreur lors de la suppression', true);
        return;
      }

      card.remove();
      updateDemandsCount();
      showDemandToast('Demande supprimee avec succes');

      if (!document.querySelector('.demand-card')) {
        window.location.reload();
      }
    } catch (error) {
      showDemandToast('Erreur reseau', true);
    }
  });
});

document.querySelectorAll('.demand-toggle').forEach((button) => {
  button.addEventListener('click', async () => {
    const card = button.closest('.demand-card');
    const demandId = card?.dataset.demandId;
    const nextStatus = button.dataset.nextStatus;
    if (!demandId) return;

    try {
      const response = await fetch(`/demandes/${demandId}/status`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ status: nextStatus })
      });
      const payload = await response.json();

      if (!response.ok || !payload.success) {
        showDemandToast(payload.error || 'Erreur lors de la mise à jour', true);
        return;
      }

      const isContacted = payload.demand.status === 'contacted';
      const statusBox = card.querySelector('.demand-status');
      const statusLabel = card.querySelector('.status-label');

      card.dataset.status = payload.demand.status;
      button.dataset.nextStatus = isContacted ? 'not_contacted' : 'contacted';
      button.textContent = isContacted ? 'Marquer non contacté' : 'Marquer contacté';

      statusBox.classList.toggle('contacted', isContacted);
      statusBox.classList.toggle('not-contacted', !isContacted);
      statusLabel.textContent = isContacted ? 'Contacté' : 'Non contacté';

      showDemandToast('Statut mis à jour');
    } catch (error) {
      showDemandToast('Erreur réseau', true);
    }
  });
});

openDeleteAllDemands?.addEventListener('click', openDeleteAllModal);
cancelDeleteAllDemands?.addEventListener('click', closeDeleteAllModal);
toggleDeleteAllDemandsCode?.addEventListener('click', () => {
  if (!deleteAllDemandsCode) return;
  const showCode = deleteAllDemandsCode.type === 'password';
  deleteAllDemandsCode.type = showCode ? 'text' : 'password';
  toggleDeleteAllDemandsCode.querySelector('.eye-open')?.classList.toggle('hidden', !showCode);
  toggleDeleteAllDemandsCode.querySelector('.eye-closed')?.classList.toggle('hidden', showCode);
});
deleteAllDemandsModal?.addEventListener('click', (event) => {
  if (event.target === deleteAllDemandsModal) {
    closeDeleteAllModal();
  }
});

deleteAllDemandsCode?.addEventListener('input', () => {
  deleteAllDemandsError.classList.add('hidden');
});

confirmDeleteAllDemands?.addEventListener('click', async () => {
  const code = String(deleteAllDemandsCode?.value || '').trim();
  deleteAllDemandsError.classList.add('hidden');

  if (!code) {
    deleteAllDemandsError.textContent = 'Veuillez saisir le code';
    deleteAllDemandsError.classList.remove('hidden');
    return;
  }

  try {
    const { response, payload } = await deleteAllDemandsRequest(code);

    if (!response.ok || !payload.success) {
      deleteAllDemandsError.textContent = payload.error || 'Mot de passe incorrecte';
      deleteAllDemandsError.classList.remove('hidden');
      return;
    }

    showDemandToast('Toutes les demandes ont ete supprimees');
    window.location.reload();
  } catch (error) {
    showDemandToast('Erreur reseau', true);
  }
});

document.addEventListener('keydown', (event) => {
  if (event.key === 'Escape') {
    closeDeleteAllModal();
  }
});
</script>

