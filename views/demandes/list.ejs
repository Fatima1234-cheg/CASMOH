<%- include('../partials/header') %>
<% const currentDirection = (typeof direction !== 'undefined' && direction) ? direction : 'MA-FR'; %>
<% const normalizePhone = (raw, direction) => {
  const rawStr = String(raw || '').trim();
  if (!rawStr) return '';

  const defaultCC = direction === 'FR-MA' ? '33' : '212';
  const knownCCs = ['212', '33', '34', '39', '49', '44', '32', '31', '41', '1', '213', '216'];
  let digits = rawStr.replace(/\D/g, '');

  if (digits.startsWith('00')) {
    digits = digits.slice(2);
  }

  const looksInternational = rawStr.startsWith('+') || rawStr.startsWith('00');
  if (looksInternational) {
    const foundCC = knownCCs.find((cc) => digits.startsWith(cc));
    if (foundCC) {
      const national = digits.slice(foundCC.length).replace(/^0+/, '');
      return national ? `${foundCC}${national}` : '';
    }
    return digits;
  }

  const existingCC = knownCCs.find((cc) => digits.startsWith(cc));
  if (existingCC) {
    const national = digits.slice(existingCC.length).replace(/^0+/, '');
    return national ? `${existingCC}${national}` : '';
  }

  digits = digits.replace(/^0+/, '');
  return digits ? `${defaultCC}${digits}` : '';
}; %>
<% const buildWhatsAppMessage = (fullName) => {
  const safeName = String(fullName || '').trim() || 'Client';
  return `Bonjour ${safeName}, Service Cashmoh. Merci pour votre demande.`;
}; %>

<div class="admin-page">
  <%- include('../partials/admin-navbar', { currentPage: 'demandes' }) %>

  <main class="admin-main">
    <div class="demands-page">
      <div class="demands-header">
        <div>
          <h1>Demandes</h1>
          <p>Soumissions envoyées par les clients depuis leur espace.</p>
        </div>
        <div class="demands-header-actions">
          <button type="button" class="demands-delete-all" id="openDeleteAllDemands">
            Supprimer tout
          </button>
          <div class="demands-count" id="demandsCount"><%= demands.length %> demande(s)</div>
        </div>
      </div>

      <% if (!demands.length) { %>
        <div class="demands-empty">
          <div class="demands-empty-icon">📭</div>
          <h2>Aucune demande pour le moment</h2>
          <p>Les nouvelles soumissions clients apparaissent ici.</p>
        </div>
      <% } %>

      <div class="demands-grid">
        <% demands.forEach(demand => { %>
          <% const fullName = `${demand.firstName || ''} ${demand.lastName || ''}`.trim(); %>
          <% const contactPhone = demand.phone || ((demand.client && demand.client.phone) ? demand.client.phone : ''); %>
          <% const isContacted = demand.status === 'contacted'; %>
          <article class="demand-card" data-demand-id="<%= demand._id %>" data-status="<%= demand.status %>">
            <div class="demand-card-head">
              <div>
                <div class="demand-name"><%= fullName || 'Client' %></div>
                <div class="demand-date"><%= new Date(demand.createdAt).toLocaleString('fr-FR') %></div>
              </div>
              <div class="demand-head-actions">
                <div class="demand-status <%= isContacted ? 'contacted' : 'not-contacted' %>">
                  <span class="status-label"><%= isContacted ? 'Contacté' : 'Non contacté' %></span>
                </div>
                <button
                  type="button"
                  class="demand-delete-icon"
                  data-demand-id="<%= demand._id %>"
                  aria-label="Supprimer cette demande"
                  title="Supprimer cette demande"
                >
                  ×
                </button>
              </div>
            </div>

            <div class="demand-body">
              <div class="demand-row">
                <span>Numéro</span>
                <strong><%= contactPhone %></strong>
              </div>
              <div class="demand-row">
                <span>Destination</span>
                <strong><%= demand.destination %></strong>
              </div>
              <div class="demand-row">
                <span>Direction</span>
                <strong><%= demand.direction === 'FR-MA' ? 'France -> Maroc' : 'Maroc -> France' %></strong>
              </div>
              <div class="demand-description">
                <span>Description du coli</span>
                <p><%= demand.parcelDescription %></p>
              </div>
            </div>

            <div class="demand-actions">
              <a
                class="demand-whatsapp"
                href="#"
                data-phone="<%= contactPhone || '' %>"
                data-direction="<%= demand.direction || 'MA-FR' %>"
                data-name="<%= fullName || 'Client' %>"
                rel="noopener noreferrer"
                aria-label="Contacter sur WhatsApp"
              >
                WhatsApp
              </a>
              <button
                type="button"
                class="demand-toggle"
                data-next-status="<%= isContacted ? 'not_contacted' : 'contacted' %>"
              >
                <%= isContacted ? 'Marquer non contacté' : 'Marquer contacté' %>
              </button>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </main>
</div>

<div id="demandToast" class="demand-toast hidden"></div>
<div id="deleteAllDemandsModal" class="demand-modal hidden" aria-hidden="true">
  <div class="demand-modal-card">
    <h3>Suppression totale</h3>
    <p>Saisissez le code de confirmation pour continuer.</p>
    <div class="demand-password-field">
      <input
        type="password"
        id="deleteAllDemandsCode"
        class="demand-modal-input demand-password-input"
        placeholder="Code de confirmation"
        autocomplete="off"
      >
      <button type="button" class="demand-password-toggle" id="toggleDeleteAllDemandsCode" aria-label="Afficher ou masquer le code">
        <span class="eye-open" aria-hidden="true">👁</span>
        <span class="eye-closed hidden" aria-hidden="true">🙈</span>
      </button>
    </div>
    <div id="deleteAllDemandsError" class="demand-modal-error hidden">Mot de passe incorrecte</div>
    <div class="demand-modal-actions">
      <button type="button" class="demand-modal-cancel" id="cancelDeleteAllDemands">Annuler</button>
      <button type="button" class="demand-modal-confirm" id="confirmDeleteAllDemands">Supprimer</button>
    </div>
  </div>
</div>

