<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/3.5.0/css/flag-icon.min.css">
<%- include('../partials/header') %>

<% const currentDirection = (typeof direction !== 'undefined' && direction) ? direction : 'MA-FR'; %>
<% const directionLabel = currentDirection === 'FR-MA' ? 'France -> Maroc' : 'Maroc -> France'; %>

<div class="admin-page">
  <%- include('../partials/admin-navbar', { currentPage: 'new-order' }) %>

  <main class="admin-main">
    <header class="admin-topbar">
      <h1 class="page-title">Créer un colis</h1>
    </header>

    <div class="direction-banner <%= currentDirection === 'FR-MA' ? 'fr-ma' : 'ma-fr' %>">
      <span class="direction-banner-label">Mode d'expedition actif</span>
      <strong><%= directionLabel %></strong>
    </div>

    <section class="parcel-form">
      
  <!-- Stepper -->
  <div class="stepper">
    <div class="stepper-line"></div>
    <div class="step active" data-step="1">
      <div class="step-circle"><span>1</span></div>
      <span class="step-label">Sender Info</span>
    </div>
    <div class="step" data-step="2">
      <div class="step-circle"><span>2</span></div>
      <span class="step-label">Receiver Info</span>
    </div>
    <div class="step" data-step="3">
      <div class="step-circle"><span>3</span></div>
      <span class="step-label">Colis & Paiement</span>
    </div>
  </div>

  <!-- Formulaire principal -->
  <form method="POST" action="/orders" enctype="multipart/form-data" id="parcelForm">
    <input type="hidden" name="direction" value="<%= currentDirection %>">
    <input type="hidden" name="client" id="selectedClientId" value="<%= order && order.client ? order.client : '' %>">

    <!-- Étape 1 : Sender Information -->
    <div class="step-content active" data-step="1">
      <div class="card card-blue">
        <div class="card-accent blue"></div>
        <div class="card-body">
          <h2 class="card-title">Expéditeur</h2>
          <p class="card-subtitle">Informations sur l'expéditeur</p>

          <div class="field-group">
            <label>Numéro de colis <span class="label-ar">(رقم الطرد)</span></label>
            <input type="text" name="orderNumber" value="<%= order && order.orderNumber ? order.orderNumber : '1' %>" readonly>
          </div>

          

       

          <div class="field-group">
            <label>Nom <span class="label-ar">(الاسم الكامل)</span></label>
            <input type="text" name="senderName" value="<%= order ? order.senderName : '' %>" placeholder="" required>
          </div>

          <div class="field-group">
            <label>Ville <span class="label-ar">(المدينة)</span></label>
            <select name="senderCity" id="senderCity" required>
              <option value="">Sélectionnez une ville</option>
              <% 
                const senderCitiesToUse = (typeof senderCities !== 'undefined' && senderCities && senderCities.length > 0)
                  ? senderCities
                  : (currentDirection === 'FR-MA' ? citiesFR : citiesMA);
                senderCitiesToUse.forEach(city => {
                  const dialCode = city.country === 'France' ? '+33' : '+212';
              %>
                <option value="<%= city.name %>" data-country="<%= dialCode %>"
                  <%= order && order.senderCity === city.name ? 'selected' : '' %>>
                  <%= city.name %>
                </option>
              <% }); %>
            </select>
          </div>

          <div class="field-group">
            <label>Telephone <span class="label-ar">(رقم الهاتف)</span></label>
            <div class="phone-input" data-phone-block data-step="1">
              <div class="cc-picker" data-flagpicker>
                <div class="cc-toggle" data-toggle>
                  <span class="flag-icon" data-flagimg></span>
                  <span data-dial-text><%= typeof defaultDialSender !== 'undefined' ? defaultDialSender : '+212' %></span>
                  <span class="arrow">▼</span>
                </div>
