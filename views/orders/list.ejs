  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  transition: all 0.2s;
}

.action-fixed:hover {
  transform: translateY(-2px);
}

.action-fixed.details:hover { background: #dbeafe; border-color: #3b82f6; }
.action-fixed.edit:hover { background: #dcfce7; border-color: #22c55e; }
.action-fixed.delete:hover { background: #fee2e2; border-color: #ef4444; }

/* ===== MODALS (details, delete) inchangés ===== */
.modal-large {
  max-width: 900px !important;
  width: 90% !important;
}

.modal-header-blue {
  background: linear-gradient(135deg, #1e3a5f, #0b2f62);
  color: white;
  padding: 20px 24px;
  border-radius: 24px 24px 0 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-header-blue h2 {
  margin: 0;
  font-size: 20px;
}

.modal-number {
  background: rgba(255,255,255,0.2);
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 600;
}

.modal-body-details {
  padding: 24px;
  max-height: 60vh;
  overflow-y: auto;
}

.details-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.details-section {
  background: #f8fafc;
  padding: 16px;
  border-radius: 16px;
}

.details-section-full {
  grid-column: span 2;
  background: #f8fafc;
  padding: 16px;
  border-radius: 16px;
}

.details-title {
  font-size: 12px;
  font-weight: 700;
  color: #0b2f62;
  letter-spacing: 1px;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 2px solid #e2e8f0;
}

.details-row {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid #e2e8f0;
  font-size: 14px;
}

.details-row span {
  color: #64748b;
}

.details-row strong {
  color: #0f172a;
}

.details-photos {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.details-photos img {
  width: 120px;
  height: 120px;
  object-fit: cover;
  border-radius: 12px;
  cursor: pointer;
  transition: transform 0.2s;
}

.details-photos img:hover {
  transform: scale(1.05);
}

.modal-actions-blue {
  padding: 16px 24px;
  border-top: 1px solid #e2e8f0;
  display: flex;
  justify-content: flex-end;
  gap: 12px;
}

.modal {
  display: none;
  position: fixed;
  z-index: 2000;
  left: 0;
  top: 0;
  width: 100%;
  height: 98%;
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(5px);
  align-items: center;
  justify-content: center;
}

.image-viewer {
  position: fixed;
  inset: 0;
  z-index: 4000;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(14px);
  padding: 24px;
}

.image-viewer.hidden {
  display: none;
}

.image-viewer-stage {
  position: relative;
  width: min(92vw, 1180px);
  height: min(82vh, 820px);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.image-viewer-stage img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  padding: 20px;
  border-radius: 24px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
}

.image-viewer-close,
.image-viewer-nav {
  border: none;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  cursor: pointer;
  backdrop-filter: blur(6px);
}

.image-viewer-close {
  position: absolute;
  top: 24px;
  right: 24px;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  font-size: 34px;
  line-height: 1;
}

.image-viewer-nav {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  font-size: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.image-viewer-counter {
  position: absolute;
  left: 50%;
  bottom: 18px;
  transform: translateX(-50%);
  background: rgba(15, 23, 42, 0.72);
  color: #fff;
  border-radius: 999px;
  padding: 8px 14px;
  font-weight: 700;
}

.modal.show {
  display: flex;
}

.modal-content {
  background: white;
  border-radius: 24px;
  width: 90%;
  max-width: 500px;
  position: relative;
  animation: modalIn 0.3s ease;
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: translateY(-30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-content.modal-small {
  max-width: 400px;
  text-align: center;
}

.modal-close {
  position: absolute;
  top: 16px;
  right: 20px;
  font-size: 28px;
  background: none;
  border: none;
  cursor: pointer;
  color: #94a3b8;
  z-index: 1;
}

.modal h2 {
  padding: 24px 24px 0 24px;
  color: #0f172a;
}

.modal-icon {
  font-size: 48px;
  margin-top: 24px;
}

.modal p {
  padding: 0 24px;
  color: #475569;
}

/* Styles globaux pour les formulaires (gardés pour cohérence) */
.form-group {
  margin-bottom: 16px;
  padding: 0 24px;
}

.form-group label {
  display: block;
  font-weight: 600;
  font-size: 13px;
  color: #1e293b;
  margin-bottom: 4px;
}

.form-group input,
.form-group select {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  font-size: 14px;
}

.form-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  padding: 0 24px;
  margin-bottom: 16px;
}

.form-group--fullwidth {
  grid-column: 1 / -1;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  padding: 20px 24px;
  border-top: 1px solid #e2e8f0;
  margin-top: 8px;
}

.btn-primary-blue {
  background: linear-gradient(135deg, #1e3a5f, #0b2f62);
  color: white;
  padding: 10px 24px;
  border-radius: 10px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-primary-blue:hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(11, 47, 98, 0.3);
}

.btn-secondary-blue {
  background: #f1f5f9;
  color: #475569;
  border: 1px solid #cbd5e1;
  padding: 10px 24px;
  border-radius: 10px;
  font-weight: 600;
  cursor: pointer;
}

.btn-secondary {
  background: #f1f5f9;
  color: #475569;
  border: 1px solid #cbd5e1;
  padding: 10px 20px;
  border-radius: 10px;
  font-weight: 600;
  cursor: pointer;
}

.btn-danger {
  background: #ef4444;
  color: white;
  padding: 10px 20px;
  border-radius: 10px;
  font-weight: 600;
  border: none;
  cursor: pointer;
}

/* ===== PAGINATION ===== */
.pagination-container {
  margin-top: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.pagination-info {
  font-size: 13px;
  color: #64748b;
}

.pagination-links {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
}

.page-link-blue {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 40px;
  height: 40px;
  padding: 0 12px;
  border-radius: 10px;
  background: #f8fafc;
  color: #334155;
  text-decoration: none;
  border: 1px solid #e2e8f0;
  transition: all 0.2s;
}

.page-link-blue:hover {
  background: #e2e8f0;
}

.page-link-blue.active {
  background: #0b2f62;
  color: white;
  border-color: #0b2f62;
}

.page-link-blue.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ===== TOAST ===== */
.toast {
  position: fixed;
  top: 24px;
  right: 24px;
  background: #10b981;
  color: white;
  padding: 14px 20px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 600;
  z-index: 2000;
  animation: slideIn 0.3s ease;
}

.toast.hidden {
  display: none;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(100px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.empty-state-fixed {
  text-align: center;
  padding: 60px;
  background: #f8fafc;
  border-radius: 20px;
}

.empty-icon {
  font-size: 64px;
  margin-bottom: 16px;
}

@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 980px) {
  .admin-page {
    grid-template-columns: 1fr;
    height: auto;
    overflow: auto;
  }
  
  .admin-sidebar {
    position: relative;
    height: auto;
  }
  
  body {
    overflow: auto;
    height: auto;
  }
  
  .stats-container {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .search-section {
    flex-direction: column;
  }
  
  .details-grid {
    grid-template-columns: 1fr;
  }
  
  .details-section-full {
    grid-column: span 1;
  }
}

@media (max-width: 640px) {
  .stats-container {
    grid-template-columns: 1fr;
  }
  
  .orders-grid-fixed {
    grid-template-columns: 1fr;
  }
  
  .form-row {
    grid-template-columns: 1fr;
  }
  
  .date-range-wrapper {
    flex-wrap: wrap;
  }
}

