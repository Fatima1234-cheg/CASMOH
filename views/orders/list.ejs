  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2100;
  align-items: center;
  justify-content: center;
}
.listadmin-modal.show {
  display: flex;
}
.listadmin-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
}
.listadmin-modal-container {
  position: relative;
  background: #fff;
  width: 90%;
  max-width: 800px;
