    grid-template-columns: 1fr;
    gap: 16px;
  }
}

.order-card-fixed {
  width: 100%;
  max-width: 100%;
}
.order-card-fixed:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
}

.card-header-fixed {
  padding: 14px 16px;
  background: #f8fafc;
