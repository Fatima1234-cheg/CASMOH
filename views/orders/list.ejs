<script>
let currentOrderData = null;
const currentDirection = '<%= currentDirection %>';
const ITEMS_PER_PAGE = 10;
const imageViewer = document.getElementById('imageViewer');
const imageViewerImg = document.getElementById('imageViewerImg');
const imageViewerCounter = document.getElementById('imageViewerCounter');
const imageViewerPrev = document.getElementById('imageViewerPrev');
const imageViewerNext = document.getElementById('imageViewerNext');
const imageViewerClose = document.getElementById('imageViewerClose');
let imageViewerPhotos = [];
let imageViewerIndex = 0;

function showToast(message, isError = false) {
  const toast = document.getElementById('toast');
  const toastMsg = document.querySelector('.toast-message');
  const toastIcon = document.querySelector('.toast-icon');
  
  toastMsg.textContent = message;
  toastIcon.textContent = isError ? '⚠️' : '✓';
  toast.style.background = isError ? '#ef4444' : '#10b981';
  toast.classList.remove('hidden');
  
  setTimeout(() => {
    toast.classList.add('hidden');
  }, 3000);
}

function isMobileDevice() {
  return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent || '');
}

function toAbsolutePhotoUrl(photo) {
  const p = String(photo || '').trim();
  if (!p) return '';
  if (/^https?:\/\//i.test(p)) return p;
  return `${window.location.origin}${p.startsWith('/') ? '' : '/'}${p}`;
}

async function tryCopyImageToClipboard(photoUrl) {
  const url = String(photoUrl || '').trim();
  if (!url) return false;
  if (!navigator.clipboard || typeof window.ClipboardItem === 'undefined') return false;
  try {
    const res = await fetch(url, { credentials: 'include', cache: 'no-store' });
    if (!res.ok) return false;
    const blob = await res.blob();
    let pngBlob = null;
    try {
      if (typeof createImageBitmap === 'function') {
        const bmp = await createImageBitmap(blob);
        const canvas = document.createElement('canvas');
        canvas.width = bmp.width;
        canvas.height = bmp.height;
        const ctx = canvas.getContext('2d');
        if (ctx) {
          ctx.drawImage(bmp, 0, 0);
          pngBlob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
        }
      }
    } catch (e) {}

    const finalBlob = pngBlob || blob;
    const items = { 'image/png': finalBlob };
    await navigator.clipboard.write([new ClipboardItem(items)]);
    return true;
  } catch (e) {
    return false;
  }
}

async function tryShareImageAndText(photoUrl, text) {
  const url = String(photoUrl || '').trim();
  if (!url) return false;
  if (!navigator.share || !navigator.canShare) return false;
  try {
    const res = await fetch(url, { credentials: 'include', cache: 'no-store' });
    if (!res.ok) return false;
    const blob = await res.blob();
    const ext = (blob.type && blob.type.includes('/')) ? blob.type.split('/')[1] : 'png';
    const file = new File([blob], `colis.${ext}`, { type: blob.type || 'image/png' });
    if (!navigator.canShare({ files: [file] })) return false;
    await navigator.share({ files: [file], text: String(text || '') });
    return true;
  } catch (e) {
    return false;
  }
}

// ===== RECHERCHE AJAX =====
const searchInput = document.getElementById('searchInput');
const dateFrom = document.getElementById('dateFrom');
const dateTo = document.getElementById('dateTo');
const clearSearchBtn = document.getElementById('clearSearch');
const clearDatesBtn = document.getElementById('clearDates');
const locationSelect = document.getElementById('locationSelect');
const btnGeneratePdf = document.getElementById('btnGeneratePdf');

async function generatePdfByDestination(toCountry) {
  try {
    const country = String(toCountry || '').toUpperCase() === 'FR' ? 'FR' : 'MA';
    const url = `/export/pdf?toCountry=${encodeURIComponent(country)}`;
    const response = await fetch(url);
    if (!response.ok) {
      const errorText = await response.text().catch(() => response.statusText || `HTTP ${response.status}`);
      if (response.status === 401) {
        showToast('Vous devez être authentifié', true);
        window.location.href = '/auth/login';
        return;
      }
      throw new Error(errorText || `HTTP ${response.status}: ${response.statusText}`);
    }
    
    const blob = await response.blob();
    const fileName = response.headers.get('content-disposition')?.split('filename="')[1]?.split('"')[0] || 'feuille-route.pdf';
    const downloadUrl = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = downloadUrl;
    a.download = fileName;
    document.body.appendChild(a);
    a.click();
    window.URL.revokeObjectURL(downloadUrl);
    document.body.removeChild(a);
    showToast(country === 'MA' ? 'Feuille de route 🇲🇦 générée' : 'Feuille de route 🇫🇷 générée');
  } catch (error) {
    console.error('Erreur lors de la génération de la feuille de route:', error);
    showToast('Erreur: ' + error.message, true);
  }
}

btnGeneratePdf?.addEventListener('click', (e) => {
  e.preventDefault();
  const activeDirectionButton = document.querySelector('.direction-toggle [data-direction-nav].active');
  const activeDirection = String(activeDirectionButton?.getAttribute('data-direction-nav') || 'MA-FR').toUpperCase();
  const toCountry = activeDirection === 'FR-MA' ? 'MA' : 'FR';
  generatePdfByDestination(toCountry);
});

let searchTimeout = null;
let isSearching = false;
let activeSearchController = null;
let activeSearchToken = 0;

function getCurrentSearchTerm() {
  return (searchInput?.value || '').trim().toLowerCase();
}

function getAllOrderCards() {
  return Array.from(document.querySelectorAll('.order-card-fixed'));
}

function getOrderCardSearchText(card) {
  if (!card) return '';
  return [
    card.dataset.orderNumber,
    card.dataset.senderName,
    card.dataset.receiverName,
    card.dataset.senderPhone,
    card.dataset.receiverPhone,
    card.dataset.fromCity,
    card.dataset.toCity,
  ].filter(Boolean).join(' ');
}

function updateVisibleResultCount(count) {
  const resultCount = document.querySelector('.result-count');
  if (resultCount) {
    resultCount.textContent = `${count} resultat(s)`;
  }
}

function applyInstantClientFilter() {
  const q = getCurrentSearchTerm();
  const cards = getAllOrderCards();
  if (!cards.length) {
    return;
  }

  let visibleCount = 0;
  cards.forEach((card) => {
    const matches = !q || getOrderCardSearchText(card).includes(q);
    card.style.display = matches ? '' : 'none';
    if (matches) visibleCount += 1;
  });

  updateVisibleResultCount(visibleCount);
}

async function updatePageWithData(url) {
  if (activeSearchController) {
    activeSearchController.abort();
  }
  const searchToken = ++activeSearchToken;
  activeSearchController = new AbortController();
  isSearching = true;
  
  try {
    const response = await fetch(url, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      signal: activeSearchController.signal
    });
    
    if (!response.ok) throw new Error('Erreur réseau');
    
    const html = await response.text();
    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = html;
    
    const newStats = tempDiv.querySelector('.stats-container');
    const newOrdersGrid = tempDiv.querySelector('.orders-grid-fixed');
    const newResultCount = tempDiv.querySelector('.result-count');
    const newPagination = tempDiv.querySelector('.pagination-container');
    
    if (newStats) {
      const oldStats = document.querySelector('.stats-container');
      if (oldStats) oldStats.innerHTML = newStats.innerHTML;
    }
    
    if (newOrdersGrid) {
      const oldGrid = document.querySelector('.orders-grid-fixed');
      if (oldGrid) {
        oldGrid.innerHTML = newOrdersGrid.innerHTML;
        attachAllEvents();
      }
    }
    
    if (newResultCount) {
      const oldCount = document.querySelector('.result-count');
      if (oldCount) oldCount.textContent = newResultCount.textContent;
    }
    
    const oldPagination = document.querySelector('.pagination-container');
    if (newPagination) {
      if (oldPagination) {
        oldPagination.innerHTML = newPagination.innerHTML;
      } else if (newPagination.innerHTML.trim()) {
        const container = document.querySelector('.orders-container');
        if (container) container.appendChild(newPagination.cloneNode(true));
      }
      attachPaginationEvents();
    } else if (oldPagination) {
      oldPagination.remove();
    }

    if (searchToken !== activeSearchToken) return;
    applyInstantClientFilter();
  } catch (error) {
    if (error.name === 'AbortError') {
      return;
    }
    console.error('Erreur:', error);
    showToast('Erreur lors du chargement des données', true);
  } finally {
    if (searchToken === activeSearchToken) {
      activeSearchController = null;
    }
    isSearching = false;
  }
}

async function performSearch() {
  const q = searchInput.value.trim();
  const from = dateFrom.value;
  const to = dateTo.value;
  const location = locationSelect?.value || '';
  
  let url = `/orders?ajax=true&limit=${ITEMS_PER_PAGE}`;
  if (q) url += `&q=${encodeURIComponent(q)}`;
  if (from) url += `&from=${from}`;
  if (to) url += `&to=${to}`;
  if (location) url += `&location=${encodeURIComponent(location)}`;
  if (currentDirection) url += `&direction=${currentDirection}`;
  
  await updatePageWithData(url);
  
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (from) params.set('from', from);
  if (to) params.set('to', to);
  if (location) params.set('location', location);
  if (currentDirection) params.set('direction', currentDirection);
  params.set('limit', ITEMS_PER_PAGE);
  
  const newUrl = '/orders' + (params.toString() ? '?' + params.toString() : '');
  window.history.pushState({}, '', newUrl);
  
  toggleClearButtons();
}

async function applyLocationToDateRange(locationValue) {
  const from = dateFrom.value;
  const to = dateTo.value;
  if (!locationValue || !from || !to) {
    return false;
  }

  try {
    const response = await fetch('/orders/bulk-location', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ location: locationValue, from, to, direction: currentDirection || undefined })
    });
    const payload = await response.json();

    if (!response.ok || !payload.success) {
      showToast(payload.error || 'Erreur lors de l’application de la localisation', true);
      return false;
    }

    showToast(`Localisation « ${locationValue} » appliquée à ${payload.modifiedCount || 0} commande(s).`);
    return true;
  } catch (error) {
    console.error('Erreur bulk location:', error);
    showToast('Erreur réseau lors de la mise à jour de la localisation.', true);
    return false;
  }
}

async function clearDates() {
  dateFrom.value = '';
  dateTo.value = '';
  await performSearch();
  toggleClearButtons();
}

async function goToPage(page) {
  const q = searchInput.value.trim();
  const from = dateFrom.value;
  const to = dateTo.value;
  const location = locationSelect?.value || '';
  
  let url = `/orders?ajax=true&page=${page}&limit=${ITEMS_PER_PAGE}`;
  if (q) url += `&q=${encodeURIComponent(q)}`;
  if (from) url += `&from=${from}`;
  if (to) url += `&to=${to}`;
  if (location) url += `&location=${encodeURIComponent(location)}`;
  if (currentDirection) url += `&direction=${currentDirection}`;
  
  await updatePageWithData(url);
  
  const params = new URLSearchParams(window.location.search);
  params.set('page', page);
  params.set('limit', ITEMS_PER_PAGE);
  if (location) params.set('location', location);
  window.history.pushState({}, '', `/orders?${params.toString()}`);
}

/**
 * Normalise un numéro de téléphone au format international pour WhatsApp.
 * Supprime espaces, parenthèses, tirets, +, caractères spéciaux.
 * Évite les doublons d'indicatifs (212212…, +212+212…).
 */
function formatPhoneForWhatsApp(rawPhone, countryCode) {
  const raw = String(rawPhone || '').trim();
  if (!raw) return '';
  const defaultCC = String(countryCode || '+212').replace(/[^0-9]/g, '') || '212';
  const knownCCs = ['213', '216', '212', '49', '44', '41', '39', '34', '33', '32', '31', '1'];

  // 1. Supprimer TOUT sauf les chiffres
  let digits = raw.replace(/[^0-9]/g, '');

  // 2. Supprimer le préfixe d'appel international « 00 »
  if (digits.startsWith('00')) digits = digits.slice(2);

  // 3. Détecter si le numéro original ressemblait à un format international
  const looksInternational = raw.startsWith('+') || raw.startsWith('00');

  // 4. Chercher un indicatif connu au début
  const matchedCC = knownCCs.find(cc => digits.startsWith(cc));

  if (matchedCC && (looksInternational || digits.length >= 11)) {
    let national = digits.slice(matchedCC.length).replace(/^0+/, '');
    // Protection anti-doublon d'indicatif
    while (national.startsWith(matchedCC)) {
      national = national.slice(matchedCC.length).replace(/^0+/, '');
    }
    return national ? `${matchedCC}${national}` : '';
  }

  // 5. Numéro commençant par l'indicatif par défaut sans +
  if (digits.startsWith(defaultCC)) {
    let national = digits.slice(defaultCC.length).replace(/^0+/, '');
    while (national.startsWith(defaultCC)) {
      national = national.slice(defaultCC.length).replace(/^0+/, '');
    }
    return national ? `${defaultCC}${national}` : '';
  }

  // 6. Numéro local
  digits = digits.replace(/^0+/, '');
  return digits ? `${defaultCC}${digits}` : '';
}

function buildReceiverWhatsAppMessage(data) {
  const parcels = String(data?.parcels || '1').trim() || '1';
  const reference = `${String(data?.num || '').trim() || 'N/A'}/${parcels}`;
  const trackingCode = String(data?.trackingCode || '').trim();

  const lines = [
    'Bonjour, service Casmoh vous remercie pour votre confiance et vous informe que nous avons bien reçu votre demande.',
    `Référence colis : ${reference}`,
  ];

  if (trackingCode) {
    lines.push(`Code de suivi : ${trackingCode}`);
  }

  lines.push('Nous vous répondrons bientôt.');
  return lines.join('\n');
}

/**
 * Ouvre WhatsApp via protocole natif (whatsapp://send) avec fallback wa.me
 */
function openWhatsAppNative(phoneDigits, message) {
  if (!phoneDigits) return;
  const encoded = encodeURIComponent(message);
  const nativeUrl = `whatsapp://send?phone=${phoneDigits}&text=${encoded}`;
  const fallbackUrl = `https://wa.me/${phoneDigits}?text=${encoded}`;

  const fallbackTimer = setTimeout(() => {
    if (document.visibilityState !== 'hidden') {
      window.open(fallbackUrl, '_blank');
    }
  }, 1500);

  const handleVisibility = () => {
    clearTimeout(fallbackTimer);
    document.removeEventListener('visibilitychange', handleVisibility);
  };
  document.addEventListener('visibilitychange', handleVisibility);

  window.location.href = nativeUrl;
}

function attachAllEvents() {
  function sanitizeLabelText(value, fallback = '-') {
    const text = String(value || '').trim();
    return text || fallback;
  }

  const LABEL_LOGO_URL = '/public/img/LOgotransparent.png';
  let labelLogoPromise = null;

  function loadLabelLogo() {
    if (!labelLogoPromise) {
      labelLogoPromise = new Promise((resolve) => {
        const image = new Image();
        image.onload = () => resolve(image);
        image.onerror = () => resolve(null);
        image.src = LABEL_LOGO_URL;
      });
    }

    return labelLogoPromise;
  }

  function buildLabelPayload(dataset) {
    return {
      receiverName: sanitizeLabelText(dataset.receiverName),
      receiverPhone: sanitizeLabelText(dataset.receiverPhone),
      receiverCity: sanitizeLabelText(dataset.receiverCity),
      receiverCountry: sanitizeLabelText(dataset.receiverCountry),
      orderReference: sanitizeLabelText(dataset.orderReference, 'N/A/1'),
      paymentMark: dataset.paid === 'true' ? 'P' : 'N',
    };
  }

  function drawRoundedRect(ctx, x, y, width, height, radius, fillStyle, strokeStyle, lineWidth = 2) {
    ctx.beginPath();
    ctx.moveTo(x + radius, y);
    ctx.lineTo(x + width - radius, y);
    ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
    ctx.lineTo(x + width, y + height - radius);
    ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
    ctx.lineTo(x + radius, y + height);
    ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
    ctx.lineTo(x, y + radius);
    ctx.quadraticCurveTo(x, y, x + radius, y);
    ctx.closePath();

    if (fillStyle) {
      ctx.fillStyle = fillStyle;
      ctx.fill();
    }

    if (strokeStyle) {
      ctx.lineWidth = lineWidth;
      ctx.strokeStyle = strokeStyle;
      ctx.stroke();
    }
  }

  async function renderLabelCanvas(labelData) {
    const canvas = document.createElement('canvas');
    canvas.width = 1280;
    canvas.height = 860;
    const ctx = canvas.getContext('2d');
    const logoImage = await loadLabelLogo();

    ctx.fillStyle = '#f3f4f6';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    drawRoundedRect(ctx, 28, 28, 1224, 804, 28, '#ffffff', '#000000', 4);
    if (logoImage) {
      const maxLogoWidth = 620;
      const maxLogoHeight = 120;
      const scale = Math.min(maxLogoWidth / logoImage.width, maxLogoHeight / logoImage.height);
      const drawWidth = logoImage.width * scale;
      const drawHeight = logoImage.height * scale;
      ctx.drawImage(logoImage, 62, 46, drawWidth, drawHeight);
    } else {
      ctx.fillStyle = '#000000';
      ctx.font = 'bold 62px Arial';
      ctx.fillText('CASMOH', 90, 120);
    }

    ctx.fillStyle = '#000000';
    ctx.font = 'bold 26px Arial';
    ctx.textAlign = 'left';
    ctx.fillText('France : +33 (0) 6 58 88 10 09', 780, 88);
    ctx.fillText('Maroc : +212 (0) 6 00 43 42 01', 780, 150);

    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.moveTo(42, 204);
    ctx.lineTo(1218, 204);
    ctx.strokeStyle = '#000000';
    ctx.stroke();

    drawRoundedRect(ctx, 48, 238, 748, 392, 0, '#ffffff', '#000000', 4);
    drawRoundedRect(ctx, 822, 238, 398, 392, 0, '#ffffff', '#000000', 4);
    drawRoundedRect(ctx, 48, 654, 748, 154, 0, '#ffffff', '#000000', 4);
    drawRoundedRect(ctx, 822, 654, 398, 154, 0, '#ffffff', '#000000', 4);

    ctx.fillStyle = '#000000';
    ctx.font = 'bold 40px Arial';
    ctx.fillText('DESTINATAIRE', 82, 304);
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.moveTo(430, 288);
    ctx.lineTo(740, 288);
    ctx.strokeStyle = '#000000';
    ctx.stroke();

    const rows = [
      ['Nom', labelData.receiverName],
      ['Téléphone', labelData.receiverPhone],
      ['Ville', labelData.receiverCity],
      ['Pays', labelData.receiverCountry],
    ];

    ctx.font = 'bold 32px Arial';
    rows.forEach(([label, value], index) => {
      const y = 382 + (index * 78);
      ctx.fillStyle = '#000000';
      ctx.fillText(label, 82, y);
      ctx.font = '32px Arial';
      ctx.fillText(value, 330, y);
      ctx.font = 'bold 32px Arial';
    });

    ctx.fillStyle = '#000000';
    ctx.font = 'bold 38px Arial';
    ctx.textAlign = 'center';
    ctx.fillText('STATUT', 1020, 304);
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.moveTo(880, 330);
    ctx.lineTo(1160, 330);
    ctx.stroke();

    ctx.font = 'bold 160px Arial';
    ctx.fillText(labelData.paymentMark, 1020, 538);

    ctx.textAlign = 'left';
    ctx.font = 'bold 34px Arial';
    ctx.fillText('N° COLIS :', 102, 746);
    ctx.font = 'bold 78px Arial';
    ctx.fillText(labelData.orderReference, 398, 754);

    ctx.textAlign = 'center';
    ctx.font = 'bold 34px Arial';
    ctx.fillText('MERCI POUR', 1020, 730);
    ctx.fillText('VOTRE CONFIANCE', 1020, 780);
    ctx.textAlign = 'left';

    return canvas;
  }

  function downloadLabelImage(dataUrl, fileName) {
    const anchor = document.createElement('a');
    anchor.href = dataUrl;
    anchor.download = fileName;
    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();
  }

  async function downloadGeneratedLabel(labelData) {
    const canvas = await renderLabelCanvas(labelData);
    const dataUrl = canvas.toDataURL('image/png');
    const safeReference = labelData.orderReference.replace(/[^\w-]+/g, '-');
    const fileName = `etiquette-${safeReference}.png`;
    downloadLabelImage(dataUrl, fileName);
    showToast(`Etiquette téléchargée: ${labelData.orderReference}`);
  }

  document.querySelectorAll('.whatsapp-fixed').forEach(btn => {
    btn.onclick = async (e) => {
      e.preventDefault();
      const phoneDigits = formatPhoneForWhatsApp(btn.dataset.phone, btn.dataset.country);
      if (!phoneDigits) return;
      const photoUrl = toAbsolutePhotoUrl(btn.dataset.photo);
      const message = buildReceiverWhatsAppMessage({
        receiver: btn.dataset.receiver,
        sender: btn.dataset.sender,
        from: btn.dataset.from,
        num: btn.dataset.num,
        parcels: btn.dataset.parcels,
        trackingCode: btn.dataset.trackingCode,
        photo: btn.dataset.photo,
      });

      if (photoUrl && isMobileDevice()) {
        const shared = await tryShareImageAndText(photoUrl, message);
        if (shared) return;
      }

      if (photoUrl && !isMobileDevice()) {
        const copied = await tryCopyImageToClipboard(photoUrl);
        if (copied) {
          showToast(`Image copiée pour ${formatReferenceWithQuantity(btn.dataset.num, btn.dataset.parcels)}. Cliquez dans WhatsApp puis Ctrl+V.`);
        } else {
          window.open(photoUrl, '_blank', 'noopener');
          showToast("Copie auto bloquée. L'image est ouverte: faites clic droit > Copier l'image.", true);
        }
      }

      openWhatsAppNative(phoneDigits, message);
    };
  });

  document.querySelectorAll('[data-label-generate]').forEach((btn) => {
    btn.onclick = async (e) => {
      e.preventDefault();
      await downloadGeneratedLabel(buildLabelPayload(btn.dataset));
    };
  });
  
  document.querySelectorAll('.details').forEach(btn => {
    btn.onclick = (e) => {
      e.preventDefault();
      const card = btn.closest('.order-card-fixed');
      const editBtn = card?.querySelector('.edit');
      if (editBtn) showDetailsModal(editBtn.dataset);
    };
  });
  
  document.querySelectorAll('.edit').forEach(btn => {
    btn.onclick = (e) => {
      e.preventDefault();
      openEditModal(btn.dataset);
    };
  });
  
  document.querySelectorAll('.delete').forEach(btn => {
    btn.onclick = (e) => {
      e.preventDefault();
      deleteId = btn.dataset.id;
      deleteModal.classList.add('show');
    };
  });
  
  document.querySelectorAll('.status-select-fixed[data-id]').forEach(select => {
    select.onchange = async () => {
      const id = select.dataset.id;
      const status = select.value;
      try {
        await fetch(`/orders/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status })
        });
        showToast(' Statut mis à jour');
        await performSearch();
      } catch (err) {
        showToast('Erreur lors de la mise à jour', true);
      }
    };
  });

  document.querySelectorAll('.js-gallery-trigger').forEach((img) => {
    img.onclick = (event) => {
      event.preventDefault();
      openImageViewer(parseViewerPhotos(img.dataset.photos), Number(img.dataset.index || 0));
    };
  });
}

function attachPaginationEvents() {
  document.querySelectorAll('.page-link-blue').forEach(link => {
    // Enlever les anciens écouteurs pour éviter les doublons
    link.removeEventListener('click', link._paginationHandler);
    if (!link.classList.contains('disabled') && link.href) {
      const handler = (e) => {
        e.preventDefault();
        const urlParams = new URLSearchParams(link.href.split('?')[1]);
        const page = urlParams.get('page');
        if (page) goToPage(page);
      };
      link.addEventListener('click', handler);
      link._paginationHandler = handler;
    }
  });
}

function formatReferenceWithQuantity(reference, quantity) {
  const ref = String(reference || '').trim() || 'N/A';
  const qty = String(quantity || '').trim() || '1';
  return `${ref}/${qty}`;
}

function renderImageViewer() {
  if (!imageViewerPhotos.length || !imageViewerImg) return;
  imageViewerImg.src = imageViewerPhotos[imageViewerIndex];
  if (imageViewerCounter) {
    imageViewerCounter.textContent = `${imageViewerIndex + 1} / ${imageViewerPhotos.length}`;
  }
  if (imageViewerPrev) imageViewerPrev.style.display = imageViewerPhotos.length > 1 ? 'inline-flex' : 'none';
  if (imageViewerNext) imageViewerNext.style.display = imageViewerPhotos.length > 1 ? 'inline-flex' : 'none';
}

function openImageViewer(photos, startIndex = 0) {
  imageViewerPhotos = Array.isArray(photos) && photos.length ? photos : ['/public/img/paquet1.png'];
  imageViewerIndex = Math.min(Math.max(startIndex, 0), imageViewerPhotos.length - 1);
  renderImageViewer();
  imageViewer?.classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}

function closeImageViewer() {
  imageViewer?.classList.add('hidden');
  document.body.style.overflow = '';
}

function moveImageViewer(step) {
  if (imageViewerPhotos.length <= 1) return;
  imageViewerIndex = (imageViewerIndex + step + imageViewerPhotos.length) % imageViewerPhotos.length;
  renderImageViewer();
}

function parseViewerPhotos(rawValue) {
  try {
    const parsed = JSON.parse(decodeURIComponent(rawValue || '[]'));
    return Array.isArray(parsed) && parsed.length ? parsed : ['/public/img/paquet1.png'];
  } catch (error) {
    return ['/public/img/paquet1.png'];
  }
}

function showDetailsModal(data) {
  const referenceWithQuantity = formatReferenceWithQuantity(data.num, data.parcels);
  document.getElementById('detailsNumber').textContent = referenceWithQuantity;
  document.getElementById('detailsSenderName').textContent = data.sender || '-';
  document.getElementById('detailsSenderPhone').textContent = data.phoneSender || '-';
  document.getElementById('detailsSenderCity').textContent = data.from || '-';
  document.getElementById('detailsSenderCountry').textContent = data.direction === 'FR-MA' ? '🇫🇷 France' : '🇲🇦 Maroc';
  document.getElementById('detailsReceiverName').textContent = data.receiver || '-';
  document.getElementById('detailsReceiverPhone').textContent = data.phoneReceiver || '-';
  document.getElementById('detailsReceiverCity').textContent = data.to || '-';
  document.getElementById('detailsReceiverCountry').textContent = data.direction === 'FR-MA' ? '🇲🇦 Maroc' : '🇫🇷 France';
  document.getElementById('detailsOrderNumber').textContent = referenceWithQuantity;
  document.getElementById('detailsParcels').textContent = data.parcels || '1';
  const paidAmountValue = data.montantPaye ?? data.montantpaye ?? data.paidAmount ?? data.paidamount ?? '';
  document.getElementById('detailsPaidAmount').textContent =
    paidAmountValue === undefined || paidAmountValue === null || paidAmountValue === '' ? '-' : String(paidAmountValue);
  const weightKgValue = data.poids ?? data.weightKg ?? data.weightkg ?? '';
  document.getElementById('detailsWeightKg').textContent =
    weightKgValue === undefined || weightKgValue === null || weightKgValue === '' ? '-' : String(weightKgValue);
  document.getElementById('detailsDirection').textContent = data.direction === 'FR-MA' ? '🇫🇷 France → 🇲🇦 Maroc' : '🇲🇦 Maroc → 🇫🇷 France';
  document.getElementById('detailsDate').textContent = new Date().toLocaleDateString('fr-FR');
  
  const statusMap = { pending: '📦 En attente', shipped: '🚚 Expédié', delivered: '✅ Livré' };
  document.getElementById('detailsStatus').innerHTML = statusMap[data.status] || data.status;
  
  const card = document.querySelector(`.edit[data-id="${data.id}"]`)?.closest('.order-card-fixed');
  const cardImage = card?.querySelector('.card-image-fixed img')?.src;
  const cardImageNode = card?.querySelector('.card-image-fixed img');
  let galleryPhotos = [];
  try {
    galleryPhotos = JSON.parse(decodeURIComponent(cardImageNode?.dataset.photos || '[]'));
  } catch (error) {
    galleryPhotos = cardImage ? [cardImage] : [];
  }
  const photosContainer = document.getElementById('detailsPhotos');
  photosContainer.innerHTML = '';
  if (galleryPhotos.length) {
    galleryPhotos.forEach((photo, index) => {
      const img = document.createElement('img');
      img.src = photo;
      img.style.cssText = 'width:120px;height:120px;object-fit:cover;border-radius:12px;cursor:pointer';
      img.onclick = () => openImageViewer(galleryPhotos, index);
      photosContainer.appendChild(img);
    });
  } else {
    photosContainer.innerHTML = '<p>Aucune photo disponible</p>';
  }
  
  currentOrderData = {
    receiverPhone: data.phoneReceiver,
    receiverName: data.receiver,
    senderName: data.sender,
    senderCity: data.from,
    orderNumber: data.num,
    parcels: data.parcels,
    direction: data.direction,
    trackingCode: data.trackingCode ?? data.trackingcode ?? '',
    photo: cardImage && !cardImage.includes('/public/img/paquet1.png') ? cardImage : '',
    photos: galleryPhotos,
  };
  detailsModal.classList.add('show');
}

function openEditModal(data) {
  document.getElementById('editId').value = data.id;
  document.getElementById('editNumber').value = data.num;
  document.getElementById('editSender').value = data.sender;
  document.getElementById('editReceiver').value = data.receiver;
  document.getElementById('editFrom').value = data.from;
  document.getElementById('editTo').value = data.to;
  document.getElementById('editStatus').value = data.status;
  document.getElementById('editSenderPhone').value = data.phoneSender || '';
  document.getElementById('editReceiverPhone').value = data.phoneReceiver || '';
  document.getElementById('editParcels').value = data.parcels || 1;
  document.getElementById('editMontantPaye').value = data.montantPaye || '';
  document.getElementById('editPoids').value = data.poids || '';
  document.getElementById('editDescriptionContenu').value = data.description || '';
  const editModalElem = document.getElementById('editModal');
  editModalElem.classList.add('show');
}

function toggleClearButtons() {
  const hasText = searchInput.value.trim() !== '';
  const hasDates = dateFrom.value !== '' || dateTo.value !== '';
  clearSearchBtn.style.display = hasText ? 'flex' : 'none';
  if (clearDatesBtn) clearDatesBtn.style.display = hasDates ? 'flex' : 'none';
}

function debounceSearch() {
  if (searchTimeout) clearTimeout(searchTimeout);
  searchTimeout = setTimeout(() => performSearch(), 180);
}

// ===== INITIALISATION =====
searchInput.addEventListener('input', () => {
  toggleClearButtons();
  applyInstantClientFilter();
  debounceSearch();
});

dateFrom.addEventListener('change', () => performSearch());
dateTo.addEventListener('change', () => performSearch());
locationSelect?.addEventListener('change', async () => {
  const location = locationSelect?.value || '';
  const fullRangeSelected = dateFrom.value && dateTo.value;

  if (location && fullRangeSelected) {
    await applyLocationToDateRange(location);
  } else if (location && !fullRangeSelected) {
    showToast('Sélectionnez une période complète pour appliquer la localisation.', true);
  }

  await performSearch();
});

clearSearchBtn.addEventListener('click', (e) => {
  e.preventDefault();
  searchInput.value = '';
  performSearch();
  toggleClearButtons();
});

if (clearDatesBtn) {
  clearDatesBtn.addEventListener('click', (e) => {
    e.preventDefault();
    dateFrom.value = '';
    dateTo.value = '';
    performSearch();
    toggleClearButtons();
  });
}

// Initialisation
toggleClearButtons();
attachAllEvents();
attachPaginationEvents();
applyInstantClientFilter();

// Forcer limit=10 dans l'URL si absent
const urlParams = new URLSearchParams(window.location.search);
if (!urlParams.has('limit')) {
  urlParams.set('limit', ITEMS_PER_PAGE);
  window.history.replaceState({}, '', `/orders?${urlParams.toString()}`);
}
const initialQ = urlParams.get('q');
const initialFrom = urlParams.get('from');
const initialTo = urlParams.get('to');
const initialLocation = urlParams.get('location');
if (initialQ) searchInput.value = initialQ;
if (initialFrom) dateFrom.value = initialFrom;
if (initialTo) dateTo.value = initialTo;
if (initialLocation && locationSelect) locationSelect.value = initialLocation;
toggleClearButtons();

// ===== GESTION DES MODALS =====
const detailsModal = document.getElementById('detailsModal');
const editModalElem = document.getElementById('editModal');
const deleteModal = document.getElementById('deleteModal');
let deleteId = null;

document.querySelectorAll('.edit-close, #cancelEdit').forEach(btn => {
  btn.addEventListener('click', () => {
    editModalElem.classList.remove('show');
  });
});

window.addEventListener('click', (e) => {
  if (e.target === editModalElem) {
    editModalElem.classList.remove('show');
  }
  if (e.target.classList.contains('modal')) closeAllModals();
});

document.getElementById('whatsappContact')?.addEventListener('click', () => {
  if (!currentOrderData?.receiverPhone) return;

  const receiverCountry = currentOrderData.direction === 'FR-MA' ? '+212' : '+33';
  const phoneDigits = formatPhoneForWhatsApp(currentOrderData.receiverPhone, receiverCountry);

  if (!phoneDigits) return;

  const message = buildReceiverWhatsAppMessage({
    num: currentOrderData.orderNumber,
    parcels: currentOrderData.parcels,
    trackingCode: currentOrderData.trackingCode,
  });

  const photoUrl = toAbsolutePhotoUrl(currentOrderData.photo);
  if (photoUrl && isMobileDevice()) {
    tryShareImageAndText(photoUrl, message).then((shared) => {
      if (shared) return;
      openWhatsAppNative(phoneDigits, message);
    });
    return;
  }

  if (photoUrl && !isMobileDevice()) {
    tryCopyImageToClipboard(photoUrl).then((copied) => {
      if (copied) showToast(`Image copiée pour ${formatReferenceWithQuantity(currentOrderData.orderNumber, currentOrderData.parcels)}. Cliquez dans WhatsApp puis Ctrl+V.`);
      else {
        window.open(photoUrl, '_blank', 'noopener');
        showToast("Copie auto bloquée. L'image est ouverte: faites clic droit > Copier l'image.", true);
      }
    });
  }

  openWhatsAppNative(phoneDigits, message);
});

function closeAllModals() {
  detailsModal?.classList.remove('show');
  editModalElem?.classList.remove('show');
  deleteModal?.classList.remove('show');
}

document.querySelectorAll('.modal-close, .details-close, .delete-close, #cancelDelete').forEach(btn => {
  btn.addEventListener('click', closeAllModals);
});

imageViewerClose?.addEventListener('click', closeImageViewer);
imageViewerPrev?.addEventListener('click', () => moveImageViewer(-1));
imageViewerNext?.addEventListener('click', () => moveImageViewer(1));
imageViewer?.addEventListener('click', (event) => {
  if (event.target === imageViewer) {
    closeImageViewer();
  }
});

window.addEventListener('click', (e) => {
  if (e.target.classList.contains('modal')) closeAllModals();
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    if (imageViewer && !imageViewer.classList.contains('hidden')) {
      closeImageViewer();
      return;
    }
    closeAllModals();
    return;
  }

  if (!imageViewer || imageViewer.classList.contains('hidden')) {
    return;
  }

  if (e.key === 'ArrowLeft') {
    e.preventDefault();
    moveImageViewer(-1);
  }

  if (e.key === 'ArrowRight') {
    e.preventDefault();
    moveImageViewer(1);
  }
});

document.getElementById('editForm')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const id = document.getElementById('editId').value;
  const data = {
    orderNumber: document.getElementById('editNumber').value,
    senderName: document.getElementById('editSender').value,
    receiverName: document.getElementById('editReceiver').value,
    senderCity: document.getElementById('editFrom').value,
    receiverCity: document.getElementById('editTo').value,
    status: document.getElementById('editStatus').value,
    senderPhone: document.getElementById('editSenderPhone').value,
    receiverPhone: document.getElementById('editReceiverPhone').value,
    parcelsCount: parseInt(document.getElementById('editParcels').value) || 1,
    paidAmount: parseFloat(document.getElementById('editMontantPaye').value) || 0,
    weightKg: parseFloat(document.getElementById('editPoids').value) || 0,
    description: document.getElementById('editDescriptionContenu').value
  };
  
  try {
    const res = await fetch(`/orders/${id}`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify(data)
    });
    const payload = await res.json().catch(() => null);
    if (res.ok && payload?.success) {
      closeAllModals();
      showToast('Commande modifiée avec succès');
      await performSearch();
    } else {
      showToast(payload?.error || 'Erreur lors de la modification', true);
    }
  } catch (err) {
    showToast('Erreur réseau', true);
  }
});

document.getElementById('confirmDelete')?.addEventListener('click', async () => {
  if (!deleteId) return;
  try {
    const res = await fetch(`/orders/${deleteId}`, { method: 'DELETE' });
    if (res.ok) {
      closeAllModals();
      showToast(' Commande supprimée avec succès');
      await performSearch();
    } else {
      showToast('Erreur lors de la suppression', true);
    }
  } catch (err) {
    showToast('Erreur réseau', true);
  }
});
</script>
