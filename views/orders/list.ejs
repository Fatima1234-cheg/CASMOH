}

.status-stock { background: #fef3c7; color: #92400e; }
.status-shipped { background: #dbeafe; color: #1e40af; }
.status-delivered { background: #dcfce7; color: #166534; }
.status-home { background: #ffedd5; color: #9a3412; }
.status-cancelled { background: #fee2e2; color: #991b1b; }

.card-image-fixed {
  position: relative;
  height: 180px;
  overflow: hidden;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-image-fixed img {
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  display: block;
  margin: 0 auto;
  cursor: zoom-in;
}

.card-image-fixed img.cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-image-fixed img.contain {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.card-image-fixed img[onerror] {
  object-fit: contain;
  padding: 20px;
}

.parcels-badge-fixed {
  position: absolute;
  top: 12px;
  left: 12px;
  background: rgba(0,0,0,0.7);
  color: white;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 11px;
  display: flex;
  align-items: center;
  gap: 5px;
}

.whatsapp-fixed {
  position: absolute;
  bottom: 12px;
  right: 12px;
  background: #25D366;
  color: white;
  border: none;
  padding: 6px 14px;
  border-radius: 25px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.whatsapp-fixed:hover {
  background: #128C7E;
  transform: scale(1.05);
}

.card-info-fixed {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 12px;
  padding: 16px;
  background: #fafbfc;
}

.info-row {
  flex: 1;
}

.info-label {
  font-size: 10px;
  font-weight: 700;
  color: #64748b;
  letter-spacing: 0.5px;
  margin-bottom: 6px;
}

.info-value {
  font-weight: 700;
  font-size: 13px;
  color: #0f172a;
  margin-bottom: 4px;
}

.info-contact, .info-location {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  color: #475569;
  margin-top: 3px;
}

.info-divider {
  width: 1px;
  background: #e2e8f0;
}

.card-actions-fixed {
  padding: 12px 16px;
  border-top: 1px solid #e2e8f0;
  display: flex;
  gap: 12px;
  background: white;
}

.status-select-fixed {
  flex: 1;
  padding: 8px 12px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 500;
  background: white;
  cursor: pointer;
}

.action-group {
  display: flex;
  gap: 6px;
}

.action-fixed {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  border: 1px solid #e2e8f0;
