}

.date-field {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
}

.date-icon {
  font-size: 14px;
  color: #64748b;
}

.date-field input {
  flex: 1;
  border: none;
  outline: none;
  font-size: 13px;
  padding: 8px 0;
  background: transparent;
}

.date-field input::placeholder {
  color: #94a3b8;
}

.date-arrow {
  color: #94a3b8;
  font-size: 14px;
}

.date-clear {
  background: none;
  border: none;
  font-size: 16px;
  cursor: pointer;
  color: #94a3b8;
  padding: 0 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  width: 28px;
  height: 28px;
  border-radius: 50%;
}

.date-clear:hover {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.1);
  transform: scale(1.1);
}

.pdf-export-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 8px 10px;
}

.pdf-destination-select {
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  padding: 9px 12px;
  font-size: 13px;
  color: #1e293b;
  background: #f8fafc;
  min-width: 210px;
  outline: none;
}

.pdf-destination-select:focus {
  border-color: #0b2f62;
  box-shadow: 0 0 0 3px rgba(11, 47, 98, 0.12);
}

.pdf-generate-btn {
  border: none;
  border-radius: 10px;
  background: linear-gradient(135deg, #1e3a5f, #0b2f62);
  color: #fff;
  font-weight: 600;
  font-size: 13px;
  padding: 9px 14px;
  cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
}

.pdf-generate-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 16px rgba(11, 47, 98, 0.25);
}

/* ===== GRILLE DES COLIS ===== */
.orders-container {
  margin-top: 10px;
}

.orders-header-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  gap:30px;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #1e293b;
}

.result-count {
  background: #e2e8f0;
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 13px;
  color: #475569;
}

.orders-grid-fixed {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
  gap: 24px;
}

.orders-grid-fixed {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
  gap: 24px;
}

@media (max-width: 768px) {
