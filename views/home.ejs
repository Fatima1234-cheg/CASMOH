    to { transform: rotate(360deg); }
  }
</style>

<script>
  const homeTrackForm = document.querySelector('.home-track-form');
  const locationModal = document.getElementById('locationModal');
  const locationText = document.getElementById('locationText');
  const locationClose = document.querySelector('.location-modal-close');

  function showLocationModal(message, isError = false) {
    if (locationText) {
      locationText.innerHTML = isError ? `<span class="location-error">${message}</span>` : message;
    }
    if (locationModal) {
      locationModal.style.display = 'flex';
    }
  }

  function hideLocationModal() {
    if (locationModal) {
      locationModal.style.display = 'none';
    }
  }

  if (homeTrackForm) {
    homeTrackForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(homeTrackForm);
      const code = (formData.get('code') || '').toString().trim();

      if (!code) {
        showLocationModal('Veuillez saisir un code de suivi.', true);
        return;
      }

      showLocationModal('<span class="spinner-small"></span> Recherche de la localisation...');

      try {
        const response = await fetch(`/track?ajax=true&code=${encodeURIComponent(code)}`);
        const result = await response.json();

        if (!result.success) {
          showLocationModal(result.error || 'Colis introuvable.', true);
          return;
        }

        const locationValue = result.localisation || 'En cours de traitement';
        showLocationModal(`Votre colis est actuellement à <strong>${locationValue}</strong>.`);
      } catch (error) {
        console.error('Erreur recherche localisation:', error);
        showLocationModal('Erreur de connexion. Veuillez réessayer.', true);
      }
    });
  }

  if (locationClose) {
    locationClose.addEventListener('click', hideLocationModal);
  }

  if (locationModal) {
    locationModal.addEventListener('click', (event) => {
      if (event.target === locationModal) {
        hideLocationModal();
      }
    });
  }
</script>

