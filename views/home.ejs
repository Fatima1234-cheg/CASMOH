  /* Styles du modal (localisation uniquement) */
  .location-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 2000;
    justify-content: center;
    align-items: center;
  }
  .location-modal-content {
    background: white;
    border-radius: 24px;
    max-width: 400px;
    width: 85%;
    box-shadow: 0 20px 35px rgba(0,0,0,0.2);
    animation: fadeSlideUp 0.2s ease-out;
    overflow: hidden;
  }
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .location-modal-header {
    background: linear-gradient(135deg, #0b2f62, #1e4a76);
    color: white;
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .location-modal-header h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
  }
  .location-modal-close {
    font-size: 28px;
    font-weight: 300;
    cursor: pointer;
    line-height: 1;
  }
  .location-modal-close:hover {
    opacity: 0.7;
  }
  .location-modal-body {
    padding: 24px 20px;
    text-align: center;
    font-size: 18px;
    font-weight: 500;
    color: #0f172a;
  }
